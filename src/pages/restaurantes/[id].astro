---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { marrakechRestaurants, restaurantCategories } from '../../data/marrakech-restaurants';
import { reservations } from '../../data/trip';
export function getStaticPaths(){return marrakechRestaurants.map(restaurant=>({params:{id:restaurant.id},props:{restaurant}}));}
const { restaurant } = Astro.props; const reservation = restaurant.reservationId ? reservations.find(item=>item.id===restaurant.reservationId) : undefined;
---
<BaseLayout title={restaurant.name}><section class="restaurant-hero"><p class="eyebrow">Marrakech · {restaurant.zone}</p><h1>{restaurant.name}</h1><p>{restaurant.description}</p><p class="price">{restaurant.price}</p></section><section class="section restaurant-detail"><div><p class="eyebrow">La experiencia</p><h2>Qué ofrece</h2><p><b>Especialidad:</b> {restaurant.specialties}</p><p><b>Ambiente:</b> {restaurant.atmosphere}</p><p><b>Por qué elegirlo:</b> {restaurant.reason}</p><p><b>Monumentos cercanos:</b> {restaurant.nearbyMonuments.length ? restaurant.nearbyMonuments.join(', ') : 'No documentados.'}</p><p><b>Terraza y vistas:</b> {restaurant.terrace ? restaurant.views : 'No consta en la información integrada.'}</p></div><aside><p class="eyebrow">Información práctica</p><h2>Antes de ir</h2><p><b>Precio:</b> {restaurant.price}</p><p><b>Estado:</b> {reservation ? `${reservation.status.replace('_',' ')} · ${reservation.note}` : 'Sin reserva asociada; disponibilidad por confirmar.'}</p><p><b>Jornadas recomendadas:</b> {restaurant.recommendedDays.length ? restaurant.recommendedDays.join(', ') : 'No asociadas.'}</p><a class="button" target="_blank" rel="noreferrer" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${restaurant.name}, ${restaurant.zone}, Marrakech`)}`}>Cómo llegar</a><button class="favorite" data-favorite={restaurant.id} aria-pressed="false">Guardar favorito ♡</button></aside></section><section class="section paper"><p class="eyebrow">Categorías</p><p>{restaurant.categories.map(category=>restaurantCategories[category]).join(' · ')}</p><p>Dirección, horario, carta, web oficial e Instagram: no constan verificados en el material integrado.</p></section></BaseLayout>
<style>.restaurant-hero{padding:clamp(3rem,8vw,7rem) max(1rem,calc((100% - 1040px)/2));background:var(--deep);color:#fff}.restaurant-hero .eyebrow{color:var(--gold)}.price{font-size:1.3rem;font-weight:700;color:var(--gold)}.restaurant-detail{display:grid;grid-template-columns:1.4fr .8fr;gap:3rem}.restaurant-detail aside{padding:1.5rem;background:var(--beige);align-self:start}.restaurant-detail .button,.restaurant-detail .favorite{margin:.4rem .4rem .4rem 0}@media(max-width:700px){.restaurant-detail{grid-template-columns:1fr;gap:1rem}}</style>
