---
import BaseLayout from '../layouts/BaseLayout.astro';
import { days, reservations } from '../data/trip';
import { itineraryImages } from '../data/itinerary-images';
import TravelImage from '../components/media/TravelImage.astro';
const firstDay = days[0]!; const firstReservation = reservations.find(item=>item.dayId===firstDay.id);
const currentDay = firstDay;
const photo = (id: string) => itineraryImages[id]!;
const stages = [{title:'Marrakech',dates:'19–22 de diciembre',text:'Palacios, medina, zocos, jardines, gastronomía y experiencias.',day:'19-diciembre',image:'19-diciembre'},{title:'Atlas y Sahara',dates:'23–27 de diciembre',text:'Kasbahs, montañas, gargantas y noches entre las dunas.',day:'23-diciembre',image:'26-diciembre'},{title:'Fez y el norte',dates:'28–30 de diciembre',text:'Medinas históricas, Chefchaouen y Tetuán.',day:'28-diciembre',image:'29-diciembre'}] as const;
const moments = [{title:'La medina despierta',day:'19-diciembre',image:'19-diciembre',kind:'previsto'},{title:'Palacios marroquíes',day:'20-diciembre',image:'20-diciembre',kind:'previsto'},{title:'Globo al amanecer',day:'21-diciembre',image:'21-diciembre',kind:'pago pendiente'},{title:'Jardines de Majorelle',day:'21-diciembre',image:'21-diciembre',kind:'previsto'},{title:'Agafay al caer el sol',day:'20-diciembre',image:'20-diciembre',kind:'confirmado'},{title:'Dunas del Sahara',day:'26-diciembre',image:'26-diciembre',kind:'por planificar'},{title:'Medina de Fez',day:'28-diciembre',image:'28-diciembre',kind:'por planificar'},{title:'Calles azules',day:'29-diciembre',image:'29-diciembre',kind:'por planificar'}] as const;
---
<BaseLayout title="Marruecos en familia"><section class="home-hero"><TravelImage image={photo('23-diciembre')} class="home-hero-image" priority={true}/><div class="home-hero-copy"><p class="eyebrow">Nuestro viaje · diciembre 2026</p><h1>Marruecos<br/><em>en familia.</em></h1><p class="lede">De las ciudades imperiales a las dunas del Sahara.</p><div class="trip-facts"><span>19–30 de diciembre</span><span>12 días · 11 noches</span><span>5 viajeros</span></div><div class="hero-actions"><a class="button" href={`/itinerario/${firstDay.id}/`}>Explorar nuestro viaje</a><a class="button button-ghost" href="/itinerario/">Consultar itinerario</a></div></div></section>
<section class="today-wrap"><div class="today-card"><div><p class="eyebrow">Nuestro viaje, día a día</p><h2>{currentDay.title}</h2><p>{new Intl.DateTimeFormat('es-ES',{day:'numeric',month:'long'}).format(new Date(`${currentDay.date}T12:00:00`))} · {currentDay.zone ?? 'Marruecos'}</p><p>Próxima reserva: <b>{firstReservation?.title ?? 'Consulta el itinerario'}</b></p></div><TravelImage image={photo(currentDay.id)} class="today-image" showCredit={false}/><a class="button" href={`/itinerario/${currentDay.id}/`}>Abrir jornada</a></div></section>
<section class="home-section stages"><div class="section-heading"><div><p class="eyebrow">El recorrido</p><h2>Tres etapas, un viaje inolvidable</h2></div><a class="text-link" href="/itinerario/">Ver diario completo</a></div><div class="stage-photo-grid">{stages.map(stage=><a class="stage-photo" href={`/itinerario/${stage.day}/`}><TravelImage image={photo(stage.image)} class="stage-image" showCredit={false}/><div><p>{stage.dates}</p><h3>{stage.title}</h3><span>{stage.text}</span></div></a>)}</div></section>
<section class="home-section moments"><div class="section-heading"><div><p class="eyebrow">Experiencias</p><h2>Momentos que no queremos perdernos</h2></div></div><div class="moments-grid">{moments.map((moment,index)=><a class:list={['moment',index===0?'moment-featured':'']} href={`/itinerario/${moment.day}/`}><TravelImage image={photo(moment.image)} class="moment-image" showCredit={false}/><div><span>{moment.kind}</span><h3>{moment.title}</h3></div></a>)}</div></section>
<section class="home-section explore"><p class="eyebrow">La guía</p><h2>Explorar nuestro viaje</h2><div class="explore-grid">{[['Diario de viaje','/itinerario/'],['Monumentos y cultura','/monumentos/'],['Restaurantes y terrazas','/restaurantes/'],['Reservas','/reservas/'],['Mapas y rutas','/mapas/'],['Control de gastos','/presupuesto/']].map(([label,href])=><a href={href}><span>✦</span><b>{label}</b><small>Descubrir</small></a>)}</div></section>
<section class="offline-home"><div><p class="eyebrow">Herramientas de viaje</p><h2>Lleva Marruecos contigo</h2><p>Descarga nuestra guía para consultarla sin conexión.</p></div><div><button class="button" data-offline-download>Descargar guía</button><p data-offline-status></p></div></section></BaseLayout>
<style>
.home-hero{position:relative;isolation:isolate;min-height:clamp(590px,76vh,860px);display:flex;align-items:end;padding:clamp(2rem,7vw,7rem) max(1rem,calc((100% - 1320px)/2));color:var(--color-surface);background:var(--color-primary);overflow:hidden}.home-hero :global(.home-hero-image){position:absolute;inset:0;z-index:-1}.home-hero :global(.home-hero-image::after){content:'';position:absolute;inset:0;background:linear-gradient(90deg,color-mix(in srgb,var(--color-primary) 90%,transparent) 0%,color-mix(in srgb,var(--color-primary) 60%,transparent) 45%,color-mix(in srgb,var(--color-primary) 20%,transparent) 100%)}.home-hero-copy{max-width:760px}.home-hero .eyebrow{color:var(--color-highlight)}h1{font-size:clamp(3.1rem,7vw,5.6rem);margin:.2rem 0}.home-hero h1 em{color:var(--color-highlight)}.lede{font:clamp(1.2rem,2vw,1.65rem)/1.4 var(--font-serif);max-width:32rem}.trip-facts{display:flex;gap:.5rem;flex-wrap:wrap;margin:1.8rem 0}.trip-facts span{padding:.45rem .7rem;background:color-mix(in srgb,var(--color-primary) 82%,transparent);border:1px solid color-mix(in srgb,var(--color-surface) 34%,transparent)}.today-wrap{max-width:1320px;margin:-3rem auto 0;padding:0 clamp(1rem,4vw,3rem);position:relative;z-index:2}.today-card{display:grid;grid-template-columns:1fr 230px auto;gap:1.5rem;align-items:center;padding:1.3rem;background:var(--color-surface);border-top:4px solid var(--color-highlight);box-shadow:var(--shadow-lg)}.today-card h2{margin:.2rem 0}.today-image{height:150px}.home-section{max-width:1320px;margin:auto;padding:clamp(4rem,8vw,7rem) clamp(1rem,4vw,3rem)}.stage-photo-grid{display:grid;grid-template-columns:1.1fr 1fr 1fr;gap:1rem}.stage-photo{position:relative;isolation:isolate;min-height:440px;display:flex;align-items:end;padding:1.5rem;color:var(--color-surface);text-decoration:none;overflow:hidden}.stage-photo :global(.stage-image){position:absolute;inset:0;z-index:-1}.stage-photo :global(.stage-image::after),.moment :global(.moment-image::after){content:'';position:absolute;inset:0;background:linear-gradient(0deg,color-mix(in srgb,var(--color-primary) 94%,transparent),transparent 70%)}.stage-photo h3{font-size:clamp(2rem,3.5vw,3.5rem);margin:.2rem 0}.stage-photo p,.moment span{color:var(--color-highlight);text-transform:uppercase;font-size:.72rem;font-weight:700;letter-spacing:.1em}.moments{max-width:none;background:var(--color-primary-soft);padding-left:max(1rem,calc((100% - 1260px)/2));padding-right:max(1rem,calc((100% - 1260px)/2))}.moments-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.moment{min-height:250px;position:relative;isolation:isolate;display:flex;align-items:end;padding:1rem;color:var(--color-surface);text-decoration:none;overflow:hidden}.moment-featured{grid-column:span 2;grid-row:span 2;min-height:516px}.moment :global(.moment-image){position:absolute;inset:0;z-index:-1}.moment h3{margin:.2rem 0;font-size:1.45rem}.explore{background:var(--color-surface)}.explore-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--color-border)}.explore-grid a{display:grid;gap:.3rem;padding:1.5rem;text-decoration:none;background:var(--color-surface);min-height:130px}.explore-grid span{color:var(--color-accent);font-size:1.5rem}.explore-grid small{color:var(--color-text-muted)}.offline-home{max-width:1320px;margin:0 auto 4rem;padding:2rem clamp(1rem,4vw,3rem);display:flex;justify-content:space-between;gap:2rem;align-items:center;background:var(--color-primary);color:var(--color-surface)}.offline-home .eyebrow{color:var(--color-highlight)}.offline-home h2{margin:.2rem 0}@media(max-width:700px){.home-hero{min-height:620px;padding-bottom:2rem}.home-hero :global(.home-hero-image::after){background:linear-gradient(0deg,color-mix(in srgb,var(--color-primary) 96%,transparent),color-mix(in srgb,var(--color-primary) 40%,transparent))}h1{font-size:clamp(2.7rem,12vw,4rem)}.today-wrap{margin:0;padding:0}.today-card{grid-template-columns:1fr;padding:1.25rem}.today-image{height:190px}.stage-photo-grid,.moments-grid,.explore-grid{grid-template-columns:1fr}.stage-photo{min-height:350px}.moment,.moment-featured{grid-column:auto;grid-row:auto;min-height:270px}.offline-home{margin:0;padding:2rem 1rem;display:block}.offline-home .button{margin-top:1rem}}
</style>
