---
import type { TripDay } from '../../types/travel'; import { getDestination } from '../../data/trip'; import { itineraryImages } from '../../data/itinerary-images'; import TravelImage from '../media/TravelImage.astro';
const { day } = Astro.props as { day: TripDay }; const destination = getDestination(day.destinationId); const image=itineraryImages[day.id]!; const number=day.id.slice(0,2);
---
<article class="day-card editorial-day"><TravelImage image={image} class="day-card-image" showCredit={false}/><div class="day-card-copy"><p class="eyebrow">Día {number} · {new Intl.DateTimeFormat('es-ES',{weekday:'long',day:'numeric',month:'long'}).format(new Date(`${day.date}T12:00:00`))}</p><h3>{day.title}</h3><p>{destination?.name} · {day.summary}</p><p class="stay">{day.accommodation}</p><a class="text-link" href={`/itinerario/${day.id}/`}>Abrir jornada</a></div></article>
<style>.editorial-day{padding:0;overflow:hidden;display:flex;flex-direction:column;min-height:420px}.day-card-image{height:210px;flex:none}.day-card-copy{padding:1.2rem;display:flex;flex-direction:column;flex:1}.day-card-copy h3{font-size:1.65rem;margin:.3rem 0}.stay{font-size:.85rem;color:var(--muted);margin-top:auto}</style>
