---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { destinations } from '../../data/trip';
---
<BaseLayout title="Destinos"><section class="page-intro"><p class="eyebrow">Lugares</p><h1>Destinos</h1><p>Una visión editorial de cada etapa, lista para completarse con contenido verificado.</p></section><section class="section destination-grid">{destinations.map(d => <article class="destination-card"><img src={d.image} alt="" loading="lazy"/><p class="eyebrow">{d.region}</p><h2>{d.name}</h2><p>{d.summary}</p><a class="text-link" href={`/destinos/${d.id}/`}>Abrir destino →</a></article>)}</section></BaseLayout>
