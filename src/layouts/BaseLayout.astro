---
import '../styles/global.css';
import '../styles/overrides.css';
import '../styles/premium.css';
import '../styles/priority-cards.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileNavigation from '../components/navigation/MobileNavigation.astro';
import PwaInstall from '../components/pwa/PwaInstall.astro';
interface Props { title: string; description?: string }
const { title, description = 'Guía privada de viaje a Marruecos 2026' } = Astro.props;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#173D35" /><meta name="apple-mobile-web-app-capable" content="yes" /><meta name="apple-mobile-web-app-status-bar-style" content="default" /><meta name="description" content={description} /><link rel="icon" href="/favicon-marruecos.png" type="image/png" /><link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" /><link rel="manifest" href="/manifest.webmanifest" /><title>{title} · Marruecos 2026</title></head><body><a class="skip-link" href="#contenido">Saltar al contenido</a><Header /><main id="contenido"><slot /></main><Footer /><MobileNavigation /><PwaInstall /><script is:inline src="/scripts/app.js"></script><script is:inline src="/scripts/pwa-install.js"></script></body></html>
