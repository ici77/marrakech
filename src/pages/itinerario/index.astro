---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { days, reservations } from '../../data/trip'; import DayCard from '../../components/itinerary/DayCard.astro'; import CurrentDayBanner from '../../components/itinerary/CurrentDayBanner.astro'; import { itineraryImages } from '../../data/itinerary-images'; import TravelImage from '../../components/media/TravelImage.astro';
const stages = [{id:'marrakech',title:'Marrakech',range:'19–22 de diciembre',text:'Palacios, zocos, jardines, gastronomía y experiencias.',items:days.slice(0,4),image:'19-diciembre'},{id:'atlas',title:'Atlas y Sahara',range:'23–27 de diciembre',text:'Kasbahs, gargantas, Navidad entre dunas y la ruta hacia Fez.',items:days.slice(4,9),image:'26-diciembre'},{id:'norte',title:'Fez y el norte',range:'28–30 de diciembre',text:'Medinas históricas, la ciudad azul y el regreso.',items:days.slice(9),image:'29-diciembre'}] as const;
---
<BaseLayout title="Nuestro itinerario"><section class="itinerary-hero"><TravelImage image={itineraryImages['23-diciembre']!} class="itinerary-hero-image" priority={true}/><div><p class="eyebrow">19–30 de diciembre de 2026</p><h1>Nuestro itinerario</h1><p>De las ciudades imperiales a las dunas del Sahara.</p><span>12 días · 11 noches · 5 viajeros</span></div></section><nav class="stage-nav" aria-label="Etapas del viaje">{stages.map(stage=><a href={`#${stage.id}`}>{stage.title} · {stage.range}</a>)}</nav><CurrentDayBanner days={days} reservations={reservations} images={itineraryImages}/>{stages.map((stage,index) => <section class:list={['trip-stage',`trip-stage-${stage.id}`]} id={stage.id}><header><p class="stage-number">Capítulo 0{index+1}</p><p class="eyebrow">{stage.range}</p><h2>{stage.title}</h2><p>{stage.text}</p></header><div class="stage-days">{stage.items.map(day => <DayCard day={day}/>)}</div></section>)}</BaseLayout>
<style>.itinerary-hero{position:relative;isolation:isolate;min-height:420px;display:grid;align-items:end;padding:clamp(2rem,6vw,5rem) max(1rem,calc((100% - 1260px)/2));color:#fff;background:var(--deep)}.itinerary-hero :global(.itinerary-hero-image){position:absolute;inset:0;z-index:-1}.itinerary-hero :global(.itinerary-hero-image::after){content:'';position:absolute;inset:0;background:linear-gradient(90deg,#183d35e8,#183d3566)}.itinerary-hero .eyebrow{color:var(--gold)}.itinerary-hero h1{margin:.3rem 0;font-size:clamp(3rem,7vw,6rem)}.stage-nav{position:sticky;top:72px;z-index:5;display:flex;gap:1.5rem;overflow:auto;padding:1rem max(1rem,calc((100% - 1260px)/2));background:var(--white);border-bottom:1px solid var(--line)}.stage-nav a{flex:none;font-weight:700;text-decoration:none}.trip-stage{max-width:1320px;margin:auto;padding:clamp(4rem,8vw,7rem) clamp(1rem,4vw,3rem);display:grid;grid-template-columns:260px 1fr;gap:2rem}.trip-stage header{align-self:start}.trip-stage h2{font-size:clamp(2.2rem,4vw,4rem);margin:.3rem 0}.stage-number{color:var(--terra);font:1.35rem var(--font-serif)}.stage-days{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem}.trip-stage-marrakech .stage-days{grid-template-columns:repeat(2,minmax(0,1fr))}.trip-stage-atlas{background:var(--sand);max-width:none;padding-left:max(1rem,calc((100% - 1260px)/2));padding-right:max(1rem,calc((100% - 1260px)/2))}.trip-stage-norte .stage-days{grid-template-columns:repeat(3,minmax(0,1fr))}@media(max-width:800px){.stage-nav{top:72px}.trip-stage{grid-template-columns:1fr;padding-top:3rem;padding-bottom:3rem}.stage-days,.trip-stage-marrakech .stage-days,.trip-stage-norte .stage-days{grid-template-columns:1fr}}</style>
