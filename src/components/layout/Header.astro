---
const primary = [['/itinerario/','Itinerario'],['/reservas/','Reservas'],['/mapas/','Mapas'],['/presupuesto/','Presupuesto']];
const secondary = [['/destinos/','Destinos y cultura'],['/restaurantes/','Restaurantes'],['/monumentos/','Monumentos'],['/informacion/','Información práctica'],['/buscar/','Buscar en la guía']];
---
<header class="site-header"><a class="brand" href="/" aria-label="Inicio, Marruecos 2026"><span>✦</span> Marruecos <small>2026</small></a><nav class="desktop-nav" aria-label="Principal">{primary.map(([href,label]) => <a href={href}>{label}</a>)}<details class="more-nav"><summary>Más <span aria-hidden="true">⌄</span></summary><div>{secondary.map(([href,label])=><a href={href}>{label}</a>)}</div></details><a class="search-link" href="/buscar/" aria-label="Buscar en la guía">⌕</a></nav></header>
<style>.site-header{gap:1rem}.desktop-nav{margin-left:auto}.desktop-nav>a,.more-nav summary{min-height:44px;display:inline-flex;align-items:center}.more-nav{position:relative}.more-nav summary{list-style:none;cursor:pointer;font-size:.9rem;font-weight:650}.more-nav summary::-webkit-details-marker{display:none}.more-nav[open] summary{color:var(--color-primary)}.more-nav>div{position:absolute;top:calc(100% + .6rem);right:0;z-index:20;display:grid;min-width:220px;padding:.45rem;background:var(--color-surface);border:1px solid var(--color-border);box-shadow:var(--shadow-md)}.more-nav>div a{padding:.6rem .7rem;text-decoration:none;font-size:.9rem}.more-nav>div a:hover{background:var(--color-background)}.search-link{font-size:1.35rem}@media(max-width:850px){.desktop-nav{gap:.8rem}.desktop-nav>a{font-size:.8rem}}@media(max-width:700px){.site-header{height:62px}.desktop-nav{display:none}}</style>
