---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RestaurantCard from '../../components/restaurants/RestaurantCard.astro';
import { marrakechRestaurants, restaurantCategories } from '../../data/marrakech-restaurants';
---

<BaseLayout title="Guía gastronómica de Marrakech">
  <section class="page-intro gastronomy-intro">
    <p class="eyebrow">Sabores de Marrakech</p><h1>Dónde comer y tomar algo</h1>
    <p>Un catálogo práctico de 27 direcciones para el viaje. Los importes son orientativos salvo las reservas indicadas; consulta siempre la carta del local antes de pedir.</p>
  </section>
  <section class="section" data-filter-root>
    <div class="filters" aria-label="Filtrar restaurantes">
      <label>Zona<select data-filter="zone"><option value="">Todas</option>{[...new Set(marrakechRestaurants.map(r=>r.zone))].map(zone=><option value={zone}>{zone}</option>)}</select></label>
      <label>Jornada<select data-filter="day"><option value="">Todas</option><option value="19-diciembre">19 dic.</option><option value="20-diciembre">20 dic.</option><option value="21-diciembre">21 dic.</option><option value="22-diciembre">22 dic.</option></select></label>
      <label>Categoría<select data-filter="category"><option value="">Todas</option>{Object.entries(restaurantCategories).map(([id,label])=><option value={id}>{label}</option>)}</select></label>
      <label>Reserva<select data-filter="reserved"><option value="">Todas</option><option value="yes">Con reserva / prevista</option></select></label>
    </div>
    <p class="catalogue-note">Las tarjetas enlazan solo a destinos útiles: web o carta cuando se ha podido verificar, la ficha y Google Maps.</p>
    <div class="food-grid">{marrakechRestaurants.map(restaurant => <div data-zone={restaurant.zone} data-day={restaurant.recommendedDays.join(' ')} data-category={restaurant.categories.join(' ')} data-reserved={restaurant.reservationId ? 'yes' : 'no'}><RestaurantCard restaurant={restaurant} /></div>)}</div>
  </section>
  <section class="section paper"><p class="eyebrow">Atardecer y vistas</p><h2>Terrazas panorámicas</h2><div class="terrace-grid">{marrakechRestaurants.filter(r=>r.terrace).map(restaurant=><RestaurantCard restaurant={restaurant} compact />)}</div></section>
</BaseLayout>
<style>.gastronomy-intro{max-width:850px}.catalogue-note{font-size:.86rem;color:var(--muted);margin:1rem 0 1.35rem}.food-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}.food-grid>div{min-width:0}.terrace-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}@media(max-width:760px){.food-grid,.terrace-grid{grid-template-columns:1fr}}</style>
