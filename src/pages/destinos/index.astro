---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { destinations, days, monuments } from '../../data/trip';
import PriorityBadge from '../../components/ui/PriorityBadge.astro';
const daysFor=(id:string)=>days.filter(day=>day.destinationId===id);
const monumentsFor=(id:string)=>monuments.filter(monument=>monument.destinationId===id);
---
<BaseLayout title="Destinos y guía cultural">
  <section class="page-intro"><p class="eyebrow">El mapa cultural del viaje</p><h1>Destinos y cultura</h1><p>Una entrada editorial a cada etapa. Aquí encontrarás qué vamos a descubrir y, cuando existe, el acceso directo a cada ficha cultural.</p></section>
  <section class="destination-editorial">{destinations.map(destination=>{const destinationDays=daysFor(destination.id), culturalStops=monumentsFor(destination.id);return <article class:list={['destination-feature',`destination-${destination.id}`]}><img src={destination.image} alt="" loading="lazy"/><div class="destination-feature__content"><p class="eyebrow">{destination.region} · {destinationDays.length} {destinationDays.length===1?'jornada':'jornadas'}</p><h2>{destination.name}</h2><p>{destination.summary}</p>{culturalStops.length>0?<><p class="feature-label">Paradas culturales de nuestra ruta</p><div class="cultural-stops">{culturalStops.filter(item=>item.priority!=='optional').slice(0,4).map(item=><a href={`/monumentos/${item.id}/`}><PriorityBadge priority={item.priority}/><span>{item.name}</span></a>)}</div><a class="button" href={`/destinos/${destination.id}/`}>Explorar la guía cultural</a></>:<><p class="destination-note">Las paradas de esta etapa se irán consolidando con el itinerario contratado.</p><a class="button" href={`/destinos/${destination.id}/`}>Ver etapa y jornadas</a></>}</div></article>})}</section>
  <section class="section paper"><p class="eyebrow">Consulta transversal</p><h2>Catálogo cultural completo</h2><p>Si buscas una visita concreta, horarios o contexto histórico, utiliza el catálogo de monumentos: no duplicamos las fichas para mantener una única fuente de información.</p><a class="button" href="/monumentos/">Ver todos los monumentos</a></section>
</BaseLayout>
<style>.destination-editorial{max-width:1240px;margin:auto;padding:0 clamp(1rem,4vw,3rem) 4rem;display:grid;gap:1.5rem}.destination-feature{display:grid;grid-template-columns:minmax(280px,.85fr) minmax(0,1.15fr);min-height:360px;background:var(--color-surface);border:1px solid var(--color-border);box-shadow:var(--shadow-md);overflow:hidden}.destination-feature img{width:100%;height:100%;min-height:360px;object-fit:cover}.destination-feature__content{padding:clamp(1.5rem,4vw,3rem);display:flex;flex-direction:column;align-items:start}.destination-feature h2{font-size:clamp(2.2rem,5vw,4.5rem);margin:.25rem 0}.destination-feature .button{margin-top:auto}.destination-note{color:var(--color-text-muted)}.feature-label{font-size:.8rem;font-weight:800;color:var(--color-primary);margin-top:1rem}.cultural-stops{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem;width:100%;margin:0 0 1.25rem}.cultural-stops a{display:flex;align-items:center;gap:.45rem;padding:.55rem;background:var(--color-background);font-size:.85rem;text-decoration:none}.destination-alto-atlas .button,.destination-merzouga .button{background:var(--color-highlight);border-color:var(--color-highlight);color:var(--color-text)}.destination-fez .button,.destination-chefchaouen .button,.destination-tetuan .button{background:var(--color-primary);border-color:var(--color-primary)}@media(max-width:700px){.destination-feature{grid-template-columns:1fr}.destination-feature img{min-height:220px}.cultural-stops{grid-template-columns:1fr}}</style>
