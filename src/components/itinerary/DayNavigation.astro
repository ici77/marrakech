---
import type { TripDay } from '../../types/travel';
import type { ItineraryImage } from '../../data/itinerary-images';
import TravelImage from '../media/TravelImage.astro';
interface Props { day: TripDay; previous?: TripDay | undefined; next?: TripDay | undefined; position: number; images: Record<string, ItineraryImage> }
const { previous, next, position, images } = Astro.props;
const date = (item: TripDay) => new Intl.DateTimeFormat('es-ES', { day:'numeric', month:'long' }).format(new Date(`${item.date}T12:00:00`));
---
<section class="day-navigation" aria-label="Entre jornadas">
  <p class="eyebrow">La ruta continúa</p><h2>Seguimos descubriendo Marruecos</h2>
  <div class:list={['journey-cards', { 'only-next': !previous, 'only-previous': !next }]}>
    {previous && <a class="journey-card previous" href={`/itinerario/${previous.id}/`}>{images[previous.id] && <TravelImage image={images[previous.id]!} class="journey-card__image" loading="lazy" showCredit={false} />}<div class="journey-card__content"><p class="journey-card__label">← Día anterior</p><p class="journey-card__number">Jornada {position - 1} · {date(previous)}</p><h3>{previous.title}</h3><p>{previous.summary}</p></div></a>}
    {next && <a class="journey-card next" href={`/itinerario/${next.id}/`}>{images[next.id] && <TravelImage image={images[next.id]!} class="journey-card__image" loading="lazy" showCredit={false} />}<div class="journey-card__content"><p class="journey-card__label">Día siguiente →</p><p class="journey-card__number">Jornada {position + 1} · {date(next)}</p><h3>{next.title}</h3><p>{next.summary}</p></div></a>}
    {!next && <aside class="journey-farewell"><p class="eyebrow">Fin del recorrido</p><p>Hasta pronto, Marruecos</p></aside>}
  </div>
  <div class="journey-footer"><p>Jornada {position} de 12</p><ol aria-label={`Jornada ${position} de 12`}>{Array.from({length:12}, (_, index) => <li class:list={{ active:index + 1 === position }}><span class="sr-only">Día {index + 1}{index + 1 === position ? ', actual' : ''}</span></li>)}</ol><a class="button" href="/itinerario/">Ver itinerario completo</a></div>
</section>
<style>.day-navigation{display:block!important;max-width:1100px;margin:0 auto;padding:clamp(2.3rem,5vw,3.6rem) clamp(1rem,4vw,3rem);text-align:left!important}.day-navigation>h2{max-width:700px;margin:.25rem 0 1.15rem;color:var(--deep);font-size:clamp(2rem,4vw,3.5rem)}.journey-cards{display:grid;grid-template-columns:.85fr 1.15fr;gap:1rem}.journey-cards.only-next,.journey-cards.only-previous{grid-template-columns:minmax(0,860px);max-width:860px;margin:0}.journey-card{display:grid;grid-template-columns:42% 1fr;min-height:190px;text-decoration:none;overflow:hidden;background:var(--white);border:1px solid var(--line);color:var(--ink)}.journey-card.next{background:var(--deep);border-color:var(--deep);color:#fff}.journey-card__image{height:100%;min-height:190px}.journey-card__image :global(img){height:100%;min-height:190px;aspect-ratio:auto}.journey-card__content{padding:1.05rem;display:flex;flex-direction:column}.journey-card__label,.journey-card__number{margin:0;font-size:.75rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.journey-card__label{color:var(--terra)}.next .journey-card__label{color:var(--gold)}.journey-card__number{margin-top:.55rem;color:var(--muted)}.next .journey-card__number{color:#dce4df}.journey-card h3{font-size:clamp(1.45rem,2.4vw,2.15rem);line-height:1.08;margin:.35rem 0}.journey-card__content>p:last-child{font-size:.92rem;line-height:1.45;margin:0}.journey-card:hover,.journey-card:focus-visible{transform:translateY(-3px);box-shadow:var(--shadow-md)}.journey-card:focus-visible{outline:3px solid var(--gold);outline-offset:3px}.journey-farewell{display:grid;place-items:center;min-height:190px;padding:1rem;text-align:center;background:var(--deep);color:#fff}.journey-farewell .eyebrow{color:var(--gold)}.journey-farewell p:last-child{font:clamp(1.8rem,4vw,3rem) var(--font-serif);margin:0}.journey-footer{display:flex!important;align-items:center;gap:1rem;margin-top:1.25rem;text-align:left}.journey-footer p{margin:0;font-weight:750;color:var(--deep);white-space:nowrap}.journey-footer ol{display:grid;grid-template-columns:repeat(12,1fr);gap:.28rem;flex:1;max-width:360px;padding:0;margin:0;list-style:none}.journey-footer li{height:5px;background:var(--beige)}.journey-footer li.active{background:var(--terra)}.journey-footer .button{margin-left:auto}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:700px){.journey-cards{grid-template-columns:1fr}.journey-cards.only-next,.journey-cards.only-previous{grid-template-columns:1fr}.journey-card{grid-template-columns:38% 1fr;min-height:165px}.journey-card__image,.journey-card__image :global(img){min-height:165px}.journey-card__content{padding:.9rem}.journey-card__content>p:last-child{display:none}.journey-card.next{order:-1}.journey-farewell{min-height:130px}.journey-footer{display:grid!important;grid-template-columns:1fr;justify-items:start}.journey-footer ol{width:100%;max-width:none}.journey-footer .button{margin-left:0;width:100%}}</style>
