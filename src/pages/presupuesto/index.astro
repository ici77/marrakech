---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { budgetCategories, budgetConfig, budgetScenarios, budgetTotals } from '../../data/trip-budget';
import { reservations } from '../../data/trip';
const eur=(value:number)=>value.toLocaleString('es-ES',{style:'currency',currency:'EUR'});
const charges=reservations.filter(item=>item.paymentDate&&item.pendingAmount).sort((a,b)=>a.paymentDate!.localeCompare(b.paymentDate!));
---
<BaseLayout title="Presupuesto previsto">
  <section class="page-intro"><p class="eyebrow">Planificación familiar</p><h1>Presupuesto previsto</h1><p>19–30 de diciembre de 2026 · {budgetConfig.days} días · {budgetConfig.nights} noches · {budgetConfig.travelers} viajeros. Los importes contratados salen de las reservas; las estimaciones se muestran separadas.</p></section>
  <section class="budget-hero"><div><span>Presupuesto máximo</span><strong data-budget-maximum>{eur(budgetConfig.maximumEur)}</strong><small>Editable solo en este dispositivo</small></div><div><span>Escenario central</span><strong>{eur(budgetScenarios.central)}</strong><small>{eur(budgetScenarios.minimum)} — {eur(budgetScenarios.maximum)}</small></div><div><span>Margen disponible</span><strong data-budget-margin>{eur(budgetConfig.maximumEur-budgetScenarios.central)}</strong><small>Respecto al escenario central</small></div><label>Objetivo familiar (€)<input type="number" min="0" step="100" value={budgetConfig.maximumEur} data-budget-input /></label><div class="budget-track"><span style={`width:${Math.min(100,budgetScenarios.central/budgetConfig.maximumEur*100)}%`}></span></div></section>
  <section class="section budget-kpis"><article><span>Ya pagado</span><b>{eur(budgetTotals.paid)}</b></article><article><span>Contratado pendiente</span><b>{eur(budgetTotals.contracted)}</b></article><article><span>Variables previstos</span><b>{eur(budgetTotals.variablesMin)} — {eur(budgetTotals.variablesMax)}</b></article><article><span>Coste por viajero</span><b>{eur(budgetScenarios.central/budgetConfig.travelers)}</b></article><article><span>Media familiar diaria</span><b>{eur(budgetScenarios.central/budgetConfig.days)}</b></article></section>
  <section class="section"><p class="eyebrow">Desglose</p><h2>En qué se compone la previsión</h2><div class="budget-categories">{budgetCategories.filter(group=>group.total>0).map(group=><details><summary><span>{group.category}</span><b>{eur(group.total)}</b><i style={`width:${Math.min(100,group.total/budgetConfig.maximumEur*100)}%`}></i></summary><div>{group.fixed.map(item=><p><span>{item.title}</span><b>{item.amountEur===undefined?'Importe pendiente de determinar':eur(item.amountEur)}</b><small>{item.state==='estimated'?'Previsión pendiente de contratar':item.state==='paid'?'Pagado':'Contratado pendiente'}</small></p>)}{group.variable.map(item=><p><span>{item.title}</span><b>{eur(item.minEur??0)}{item.maxEur!==item.minEur&&` — ${eur(item.maxEur??0)}`}</b><small>{item.note}</small></p>)}</div></details>)}</div></section>
  <section class="section paper"><p class="eyebrow">Pagos comprometidos</p><h2>Calendario de cargos</h2><div class="charge-list">{charges.map(item=><article><time>{new Intl.DateTimeFormat('es-ES',{day:'numeric',month:'long'}).format(new Date(`${item.paymentDate}T12:00:00`))}</time><span>{item.title}</span><b>{eur((item.pendingAmount?.amount??0)/100)}</b></article>)}</div></section>
  <section class="section"><p class="eyebrow">Durante el viaje</p><h2>Control de gastos reales</h2><p>El presupuesto previsto no cambia al registrar un gasto. Este registro se guarda localmente y permite comparar la realidad con la planificación.</p><div class="budget-total"><span>Gastado real</span><strong data-expense-total>0,00 €</strong><small>Gastos reales guardados localmente</small></div><form class="expense-form" data-expense-form><label>Concepto<input required name="title" maxlength="80"/></label><label>Importe<input required name="amount" type="number" min="0" step="0.01"/></label><label>Moneda<select name="currency"><option>EUR</option><option>MAD</option></select></label><label>Categoría<input name="category" value="Otros"/></label><button class="button">Añadir gasto</button></form><div class="export-actions"><button data-export>Exportar copia JSON</button><label>Importar copia<input data-import type="file" accept="application/json"/></label></div><div data-expense-list class="expense-list"></div></section>
</BaseLayout>
<script define:vars={{ central: budgetScenarios.central }}>// @ts-nocheck
const key='marruecos-2026:budget-maximum:v1', input=document.querySelector('[data-budget-input]'), maximum=document.querySelector('[data-budget-maximum]'), margin=document.querySelector('[data-budget-margin]');const format=value=>value.toLocaleString('es-ES',{style:'currency',currency:'EUR'});const render=()=>{const value=Number(localStorage.getItem(key)||input.value);input.value=value;maximum.textContent=format(value);margin.textContent=format(value-central)};input?.addEventListener('change',()=>{localStorage.setItem(key,String(input.value));render()});render();</script>
<style>.budget-hero{max-width:1180px;margin:0 auto;padding:1.5rem clamp(1rem,4vw,3rem);display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--color-border)}.budget-hero>div,.budget-hero label{display:grid;gap:.25rem;padding:1rem;background:var(--color-secondary);color:var(--color-surface)}.budget-hero label{background:var(--color-surface);color:var(--color-text);font-size:.8rem}.budget-hero span,.budget-hero small{font-size:.78rem;color:color-mix(in srgb,var(--color-surface) 82%,var(--color-primary-soft))}.budget-hero label{color:var(--color-text)}.budget-hero strong{font:clamp(1.7rem,3vw,2.8rem) var(--font-serif)}.budget-track{grid-column:1/-1;height:7px;background:var(--color-surface);padding:0!important}.budget-track span{display:block;height:100%;background:var(--color-primary)}.budget-kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:.8rem;padding-top:2rem;padding-bottom:2rem}.budget-kpis article{padding:1rem;background:var(--color-surface);border-top:3px solid var(--color-accent);box-shadow:var(--shadow-sm)}.budget-kpis span,.budget-kpis b{display:block}.budget-kpis span{font-size:.75rem;color:var(--color-text-muted)}.budget-kpis b{font:1.35rem var(--font-serif);color:var(--color-primary)}.budget-categories{display:grid;gap:.7rem}.budget-categories details{padding:1rem;background:var(--color-surface);border:1px solid var(--color-border)}.budget-categories summary{display:grid;grid-template-columns:1fr auto;align-items:center}.budget-categories summary i{grid-column:1/-1;height:5px;margin-top:.6rem;background:var(--color-primary)}.budget-categories details>div{margin-top:1rem}.budget-categories p{display:grid;grid-template-columns:1fr auto;gap:.2rem 1rem;padding:.6rem 0;margin:0;border-top:1px solid var(--color-border)}.budget-categories small{grid-column:1/-1;color:var(--color-text-muted)}.charge-list{display:grid;gap:.5rem}.charge-list article{display:grid;grid-template-columns:130px 1fr auto;gap:1rem;padding:.8rem;background:var(--color-warning-bg);border-left:3px solid var(--color-warning)}.charge-list time{font-weight:800;color:var(--color-warning)}@media(max-width:700px){.budget-hero,.budget-kpis{grid-template-columns:1fr 1fr}.budget-hero label{grid-column:span 2}.budget-kpis article:last-child{grid-column:span 2}.charge-list article{grid-template-columns:1fr}.budget-categories p{grid-template-columns:1fr}}</style>
