---
import type { Destination, MarrakechRestaurant, Monument, Reservation, TripDay, RestaurantRecommendation } from '../../types/travel';
import PriorityBadge from '../ui/PriorityBadge.astro'; import ReservationStatus from '../ui/ReservationStatus.astro'; import TravelImage from '../media/TravelImage.astro'; import type { ItineraryImage } from '../../data/itinerary-images'; import DailyRestaurants from './DailyRestaurants.astro'; import CircuitGuide from './CircuitGuide.astro'; import MarrakechFreeEvening from './MarrakechFreeEvening.astro'; import MarrakechEveningFood from './MarrakechEveningFood.astro'; import { circuitGuide } from '../../data/circuit-guide';
interface Props { day:TripDay; destination:Destination|undefined; image?:ItineraryImage|undefined; reservations:Reservation[]; monuments:Monument[]; restaurants:MarrakechRestaurant[]; restaurantRecommendations:RestaurantRecommendation[] }
const {day,destination,image,reservations,monuments,restaurants,restaurantRecommendations}=Astro.props;
const isLogistic=(a:TripDay['activities'][number])=>/llegada al alojamiento|traslado al riad|controles de entrada|recogida para|salida de/i.test(a.title);
const score=(a:TripDay['activities'][number])=>/aït ben haddou|ait ben haddou/i.test(a.title)?20:/dromedario|globo|cena-espectáculo|cena y espectáculo|hammam|gargantas|4×4|4x4|sandboarding|palacios|free tour/i.test(a.title)?10:1;
const featured=day.id==='20-diciembre'
  ? day.activities.filter(a=>['20-tour','20-jemaa-noche','20-azotea'].includes(a.id))
  : day.id==='22-diciembre'
    ? day.activities.filter(a=>['22-nouba','22-hammam','22-badi'].includes(a.id)).sort((a,b)=>['22-nouba','22-hammam','22-badi'].indexOf(a.id)-['22-nouba','22-hammam','22-badi'].indexOf(b.id))
    : day.activities.filter(a=>a.priority!=='optional'&&!isLogistic(a)).sort((a,b)=>score(b)-score(a)).slice(0,3);
const prettyDate=new Intl.DateTimeFormat('es-ES',{weekday:'long',day:'numeric',month:'long'}).format(new Date(`${day.date}T12:00:00`)); const circuitDay=circuitGuide[day.id]; const reservationFor=(a:TripDay['activities'][number])=>reservations.find(item=>item.id===a.reservationId);
---
<section class="guide-hero" style={`background-image:linear-gradient(90deg,rgba(24,47,80,.9),rgba(24,47,80,.22)),url('${destination?.image??'/images/marrakech.svg'}')`}>{image&&<TravelImage image={image} class="guide-hero-photo" priority={true} showCredit={true}/>}<div class="guide-hero-content"><p class="eyebrow">{prettyDate} · {destination?.name}</p><h1>{day.title}</h1><p>{day.summary}</p><div class="guide-meta"><span>⌂ {day.accommodation}</span><span>{day.zone??'Planificación de jornada'}</span><span>◷ 5 viajeros</span></div></div></section>
<nav class="guide-toc" aria-label="Índice de jornada">{reservations.length>0&&<a href="#reservas">Reservas</a>}<a href="#planning">Planning</a>{monuments.length>0&&<a href="#cultura">Cultura</a>}{restaurantRecommendations.length>0&&<a href="#comer">Comer</a>}</nav>
{circuitDay&&<CircuitGuide guide={circuitDay}/>}<section class="day-progress" data-day-progress data-activity-ids={day.activities.map(a=>a.id).join(',')}><div><b>Progreso de la jornada</b><span data-progress-label>0 realizadas · 0 omitidas · {day.activities.length} pendientes</span></div><div class="day-progress-track"><span data-progress-bar></span></div></section>
{reservations.length>0&&<section class="guide-section" id="reservas"><p class="eyebrow">No perder de vista</p><h2>Reservas y servicios</h2><div class="guide-reservations">{reservations.map(r=><article><ReservationStatus status={r.status}/><h3>{r.title}</h3><p><b>{r.date}</b> · {r.travelers} viajeros</p><p>{r.note}</p>{r.amount&&<p class="amount">{(r.amount.amount/100).toLocaleString('es-ES',{minimumFractionDigits:2})} {r.amount.currency}</p>}</article>)}</div></section>}
<section class="key-moments" aria-labelledby="key-moments-title"><div class="key-moments__heading"><div><p class="eyebrow">Momentos clave</p><h2 id="key-moments-title">Experiencias que definen la jornada</h2></div><p>Una selección editorial de los lugares y experiencias que merece la pena priorizar hoy.</p></div>{featured.length?<div class:list={['key-moments__grid',{'has-single':featured.length===1}]}>{featured.map((a,index)=>{const r=reservationFor(a);return <article class:list={['moment-card',{'moment-card--featured':index===0}]}><div class="moment-card__body">{index===0&&image&&<TravelImage image={image} class="moment-card__image" loading="lazy" showCredit={false}/>}<div class="moment-card__content"><div class="moment-card__meta"><span class="moment-card__number">{String(index+1).padStart(2,'0')}</span><PriorityBadge priority={a.priority}/>{r&&<ReservationStatus status={r.status}/>}</div><h3>{a.title}</h3><p>{a.description}</p>{a.reservationId&&<a href="#reservas">Ver reserva y detalles →</a>}{a.monumentId&&<a href="#cultura">Consultar ficha cultural →</a>}</div></div></article>})}</div>:<p class="key-moments__empty">Las experiencias de esta jornada aún están pendientes de concretar.</p>}</section>
{day.id==='20-diciembre'&&<MarrakechFreeEvening />}
<section class="guide-section" id="planning"><p class="eyebrow">El día, paso a paso</p><h2>Planning cronológico</h2><ol class="guide-timeline">{day.activities.map((a,index)=><li data-progress-activity={a.id}><time>{a.start??'Por fijar'}</time><div><span>{String(index+1).padStart(2,'0')}</span><h3>{a.title}</h3><PriorityBadge priority={a.priority}/><p>{a.description}</p><small>{a.status==='confirmed'?'Hora prevista en planning; comprobar la reserva vinculada.':'Horario o actividad pendiente de confirmar.'}</small><div class="activity-actions"><label><input type="checkbox" data-activity-complete={a.id}/> Realizada</label><button type="button" data-activity-skip={a.id}>Omitir</button><button type="button" data-activity-reset={a.id} hidden>Restablecer</button></div></div></li>)}</ol></section>
{monuments.length>0&&<section class="guide-section guide-culture" id="cultura"><p class="eyebrow">Guía de bolsillo</p><h2>Monumentos y paradas culturales</h2><div class="guide-monuments">{monuments.map(m=><article><PriorityBadge priority={m.priority}/><h3>{m.name}</h3><dl><div><dt>Visita prevista</dt><dd>{m.openingHours}</dd></div><div><dt>Referencia de precio</dt><dd>{m.admission}</dd></div><div><dt>Duración</dt><dd>{m.duration}</dd></div></dl><details><summary>Consultar ficha cultural</summary><p>{m.cultural}</p><p>{m.history}</p><p>{m.architecture}</p><p>{m.observe}</p><p>{m.route}</p></details></article>)}</div></section>}
{day.id==='20-diciembre'?<MarrakechEveningFood restaurants={restaurants}/>:<DailyRestaurants recommendations={restaurantRecommendations} restaurants={restaurants}/>} 
<style>
.guide-hero{position:relative;isolation:isolate;min-height:470px;display:grid;align-items:end;background-position:center;background-size:cover;color:#fff}.guide-hero :global(.guide-hero-photo){position:absolute;inset:0;z-index:0}.guide-hero :global(.guide-hero-photo::after){content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(24,47,80,.9),rgba(24,47,80,.28))}.guide-hero-content{position:relative;z-index:1;max-width:850px;padding:clamp(2rem,7vw,6rem)}.guide-hero .eyebrow{color:#f1d39d}.guide-hero h1{font-size:clamp(2.8rem,7vw,6rem);margin:.4rem 0}.guide-meta{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:1.5rem}.guide-meta span{padding:.3rem .6rem;background:#182f50c9;border:1px solid #fff6;font-size:.82rem}.guide-toc{position:sticky;top:56px;z-index:4;display:flex;gap:1rem;overflow:auto;padding:.65rem max(1rem,calc((100% - 1100px)/2));background:var(--white);border-bottom:1px solid var(--line)}.guide-toc a{flex:none;font-size:.82rem;font-weight:700;text-decoration:none}.guide-section,.day-progress{max-width:1100px;margin:auto;padding:clamp(2.5rem,6vw,5rem) clamp(1rem,4vw,3rem)}.guide-reservations{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem}.guide-reservations article{padding:1.3rem;background:#182f50;border-top:4px solid #956536;color:#fff}.guide-reservations h3{margin-top:1rem}.guide-reservations .amount{color:#f1d39d;font-size:1.15rem;font-weight:700}.day-progress{padding-top:1rem;padding-bottom:1rem;display:grid;gap:.55rem}.day-progress>div:first-child{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}.day-progress-track{height:6px;background:var(--line)}.day-progress-track span{display:block;width:0;height:100%;background:#956536;transition:width .2s}
.key-moments{padding:clamp(2.8rem,5vw,4.5rem) max(1rem,calc((100% - 1040px)/2));background:#f8f9fb;color:#253347}.key-moments__heading{display:flex;justify-content:space-between;gap:2rem;align-items:end;max-width:1040px;margin:0 auto 1.5rem}.key-moments .eyebrow{color:#956536}.key-moments h2{max-width:680px;margin:.3rem 0 0;color:#182f50;font-size:clamp(2rem,3.5vw,3.2rem);line-height:1.1}.key-moments__heading>p{max-width:330px;margin:0;color:#566273;line-height:1.55}.key-moments__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.15rem;max-width:1040px;margin:auto}.key-moments__grid.has-single{grid-template-columns:minmax(0,760px)}.moment-card{background:#fff;border:1px solid #e1e5eb;box-shadow:0 8px 24px #182f5010}.moment-card--featured{grid-column:span 2}.has-single .moment-card--featured{grid-column:auto}.moment-card__body{display:grid;grid-template-columns:minmax(240px,43%) 1fr;height:100%}.moment-card:not(.moment-card--featured) .moment-card__body{display:block}.moment-card__image{height:100%;min-height:250px}.moment-card__image :global(img){height:100%;min-height:250px;aspect-ratio:auto;object-fit:cover}.moment-card__content{padding:1.35rem}.moment-card__meta{display:flex;align-items:center;gap:.45rem;flex-wrap:wrap;margin-bottom:.75rem}.moment-card__number{color:#956536;font-size:.78rem;font-weight:800;letter-spacing:.12em}.moment-card :global(.badge){font-size:.7rem}.moment-card h3{margin:0 0 .55rem;color:#182f50;font-size:clamp(1.3rem,2vw,1.9rem);line-height:1.12}.moment-card p{margin:0;color:#566273;line-height:1.55}.moment-card a{display:inline-block;margin-top:1rem;color:#182f50;font-size:.9rem;font-weight:800}.moment-card a:focus-visible,.guide-toc a:focus-visible{outline:3px solid #956536;outline-offset:3px}.key-moments__empty{max-width:1040px;margin:auto;color:#566273}
.guide-timeline{padding:0;margin:2rem 0;list-style:none}.guide-timeline li{display:grid;grid-template-columns:130px 1fr;gap:1rem;padding-bottom:2rem}.guide-timeline time{color:var(--terra);font-weight:700}.guide-timeline li>div{position:relative;padding-left:1.4rem;border-left:1px solid var(--gold)}.guide-timeline li>div>span{position:absolute;left:-.6rem;top:0;width:1.2rem;height:1.2rem;border-radius:50%;background:var(--terra);color:#fff;text-align:center;font-size:.62rem;line-height:1.2rem}.guide-timeline h3{display:inline;margin-right:.5rem}.guide-timeline small{color:var(--muted)}.activity-actions{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;margin-top:.8rem}.activity-actions label,.activity-actions button{font:inherit;font-size:.82rem;padding:.35rem .5rem;border:1px solid var(--line);background:var(--white);cursor:pointer}.guide-timeline li[data-state="completed"]>div{opacity:.65}.guide-timeline li[data-state="completed"] h3{text-decoration:line-through}.guide-timeline li[data-state="skipped"]>div{opacity:.55}.guide-culture{max-width:none;background:var(--white);padding-left:max(1rem,calc((100% - 1040px)/2));padding-right:max(1rem,calc((100% - 1040px)/2))}.guide-monuments{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.guide-monuments article{padding:1.3rem;background:var(--sand);border:1px solid var(--line)}.guide-monuments h3{margin-top:1rem}.guide-monuments dl{display:grid;gap:.6rem;grid-template-columns:repeat(3,1fr)}.guide-monuments details{margin-top:1rem;padding-top:.7rem;border-top:1px solid var(--line)}.guide-monuments summary{font-weight:700}
@media(max-width:700px){.guide-hero{min-height:420px}.guide-toc{top:56px}.day-progress>div:first-child,.key-moments__heading{display:block}.key-moments__heading>p{margin-top:.7rem}.key-moments__grid,.moment-card--featured,.moment-card__body,.guide-monuments{grid-template-columns:1fr}.moment-card--featured{grid-column:auto}.moment-card__image,.moment-card__image :global(img){min-height:205px;height:205px}.guide-timeline li{grid-template-columns:1fr;gap:.3rem}.guide-timeline li>div{margin-left:.25rem}.guide-monuments dl{grid-template-columns:1fr}}
</style>
<script>
// @ts-nocheck
import { dayProgress, readProgress, setProgressState } from '../../lib/trip-progress';
const renderProgress=()=>{document.querySelectorAll('[data-day-progress]').forEach(root=>{const ids=root.dataset.activityIds.split(',').filter(Boolean);const value=dayProgress(ids);root.querySelector('[data-progress-label]').textContent=`${value.completed} realizadas · ${value.skipped} omitidas · ${value.pending} pendientes`;root.querySelector('[data-progress-bar]').style.width=`${value.percent}%`;ids.forEach(id=>{const state=readProgress().activities[id]?.state||'pending';const item=document.querySelector(`[data-progress-activity="${id}"]`);if(!item)return;item.dataset.state=state;item.querySelector('[data-activity-complete]').checked=state==='completed';item.querySelector('[data-activity-skip]').hidden=state!=='pending';item.querySelector('[data-activity-reset]').hidden=state==='pending';});});};document.querySelectorAll('[data-activity-complete]').forEach(control=>control.addEventListener('change',()=>{setProgressState('activities',control.dataset.activityComplete,control.checked?'completed':'pending');renderProgress()}));document.querySelectorAll('[data-activity-skip]').forEach(button=>button.addEventListener('click',()=>{setProgressState('activities',button.dataset.activitySkip,'skipped');renderProgress()}));document.querySelectorAll('[data-activity-reset]').forEach(button=>button.addEventListener('click',()=>{setProgressState('activities',button.dataset.activityReset,'pending');renderProgress()}));window.addEventListener('trip-progress-change',renderProgress);window.addEventListener('storage',event=>{if(event.key==='marruecos-2026:progress:v1')renderProgress()});renderProgress();
</script>
