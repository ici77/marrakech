---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { destinations, days, monuments } from '../../data/trip';
import PriorityBadge from '../../components/ui/PriorityBadge.astro';
export function getStaticPaths() { return destinations.map(destination => ({params:{id:destination.id},props:{destination}})); }
const { destination } = Astro.props;
const stageDays=days.filter(day=>day.destinationId===destination.id);
const culturalStops=monuments.filter(monument=>monument.destinationId===destination.id);
---
<BaseLayout title={`${destination.name} · guía cultural`}><section class="destination-hero"><img src={destination.image} alt=""/><div><p class="eyebrow">{destination.region}</p><h1>{destination.name}</h1><p>{destination.summary}</p><p>{stageDays.length} {stageDays.length===1?'jornada prevista':'jornadas previstas'} en esta etapa.</p></div></section><section class="section"><p class="eyebrow">Nuestro recorrido</p><h2>Jornadas en {destination.name}</h2><div class="journey-days">{stageDays.map((day,index)=><a href={`/itinerario/${day.id}/`}><span>{String(index+1).padStart(2,'0')}</span><div><h3>{day.title}</h3><p>{day.summary}</p></div></a>)}</div></section>{culturalStops.length>0&&<section class="section paper"><p class="eyebrow">Guía cultural</p><h2>Lo que queremos entender y visitar</h2><div class="cultural-grid">{culturalStops.map(monument=><article><PriorityBadge priority={monument.priority}/><h3>{monument.name}</h3><p>{monument.cultural}</p><dl><div><dt>Visita</dt><dd>{monument.openingHours}</dd></div><div><dt>Duración</dt><dd>{monument.duration}</dd></div></dl><a class="text-link" href={`/monumentos/${monument.id}/`}>Abrir ficha cultural →</a></article>)}</div></section>}<section class="section"><a class="text-link" href="/destinos/">← Todos los destinos</a> · <a class="text-link" href="/monumentos/">Catálogo de monumentos</a></section></BaseLayout>
<style>.destination-hero{position:relative;isolation:isolate;display:grid;align-items:end;min-height:460px;padding:clamp(2rem,7vw,6rem) max(1rem,calc((100% - 1180px)/2));color:var(--color-surface);background:var(--color-primary);overflow:hidden}.destination-hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-1}.destination-hero:after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,color-mix(in srgb,var(--color-primary) 88%,transparent),color-mix(in srgb,var(--color-primary) 30%,transparent))}.destination-hero div{max-width:700px}.destination-hero .eyebrow{color:var(--color-highlight)}.destination-hero h1{font-size:clamp(3.5rem,8vw,7rem);margin:.2rem 0}.journey-days,.cultural-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.journey-days a{display:grid;grid-template-columns:50px 1fr;gap:1rem;padding:1.2rem;background:var(--color-surface);border:1px solid var(--color-border);text-decoration:none}.journey-days span{font:1.6rem var(--font-serif);color:var(--color-primary)}.journey-days h3,.cultural-grid h3{margin:0}.journey-days p{margin:.3rem 0 0;color:var(--color-text-muted)}.cultural-grid article{padding:1.3rem;background:var(--color-background);border:1px solid var(--color-border)}.cultural-grid dl{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.cultural-grid dt{font-size:.7rem;color:var(--color-text-muted);text-transform:uppercase}.cultural-grid dd{margin:0}@media(max-width:700px){.journey-days,.cultural-grid{grid-template-columns:1fr}.destination-hero{min-height:400px}}</style>
