---
import type { MarrakechRestaurant } from '../../types/travel';
interface Props { restaurants:MarrakechRestaurant[] }
const {restaurants}=Astro.props;
const find=(id:string)=>restaurants.find(item=>item.id===id);
const groups:{eyebrow:string;title:string;copy:string;ids:string[];notes:Record<string,string>}[]=[
  {eyebrow:'Marrakech desde las alturas',title:'Té, vistas y atardecer',copy:'Azoteas para hacer una pausa mientras la medina cambia de luz. Son alternativas: elegid una según el ambiente y la mesa disponible.',ids:['restaurant-amornakoch','restaurant-cafe-des-epices','restaurant-coco-rooftop','restaurant-zeitoun-cafe'],notes:{'restaurant-amornakoch':'Opción preferente para cinco tés con vistas a Jemaa el-Fna; estimación orientativa de 8 € para cinco.','restaurant-cafe-des-epices':'Pausa informal durante los zocos, con la plaza de las Especias a los pies.','restaurant-coco-rooftop':'Alternativa premium para atardecer; también permite convertir la pausa en cena, si apetece.','restaurant-zeitoun-cafe':'Alternativa panorámica directamente en el entorno de Jemaa el-Fna.'}},
  {eyebrow:'Sabores auténticos de Marrakech',title:'Un bocado entre zocos',copy:'Para degustar algo sencillo durante el paseo o elegir una cena tradicional sin presentar ninguna opción como garantía de higiene.',ids:['restaurant-chez-hicham','restaurant-el-bahja','restaurant-cafe-babouche'],notes:{'restaurant-chez-hicham':'Bocadillos callejeros en Derb Dabachi; referencia orientativa de 5–7 € para cinco bocadillos.','restaurant-el-bahja':'Cocina tradicional económica cerca de la plaza; estimación orientativa de 16–35 € para cinco.','restaurant-cafe-babouche':'Restaurante tradicional de la medina; estimación orientativa de 40–56 € para cinco.'}},
  {eyebrow:'Una cena entre las luces de la medina',title:'Elegir una sola mesa',copy:'Alternativas, no un recorrido acumulativo. Los importes son estimaciones para cinco, nunca reservas ni precios confirmados.',ids:['restaurant-taj-in-darna','restaurant-mo-mo-jemaa-el-fna','restaurant-l-mida','restaurant-dar-dar','restaurant-coco-rooftop'],notes:{'restaurant-taj-in-darna':'Opción preferente por ubicación, cocina marroquí y equilibrio general; ≈75 € para cinco.','restaurant-mo-mo-jemaa-el-fna':'Terraza sobre la plaza para cenar; ≈125–150 € para cinco.','restaurant-l-mida':'Cocina marroquí contemporánea y rooftop; ≈90–140 € para cinco.','restaurant-dar-dar':'Terraza moderna y ambiente animado; ≈125–200 € para cinco.','restaurant-coco-rooftop':'Alternativa panorámica premium; ≈159 € para cinco si se elige cena.'}},
  {eyebrow:'Marrakech bajo las estrellas',title:'Una última bebida',copy:'Confirmar horarios, acceso para la adolescente, opciones sin alcohol, disponibilidad y condiciones de terraza en diciembre. Conviene regresar temprano: el globo sale al amanecer.',ids:['restaurant-el-fenn-rooftop','restaurant-la-pergola','restaurant-dar-dar','restaurant-kabana'],notes:{'restaurant-el-fenn-rooftop':'Opción preferente por ambiente boutique y diseño; cócteles estimados entre 120 y 200 MAD.','restaurant-la-pergola':'Terraza bohemia con ambiente musical cerca de Jemaa el-Fna.','restaurant-dar-dar':'Alternativa contemporánea para terminar la noche.','restaurant-kabana':'Ambiente cosmopolita, decoración tropical y música; referencia de 160 MAD por cóctel de autor.'}}
];
---
<section class="evening-food" id="comer" aria-labelledby="evening-food-title"><header><p class="eyebrow">Guía gastronómica · domingo 20</p><h2 id="evening-food-title">Elegir sobre la marcha</h2><p>No hay nuevas reservas: estas recomendaciones reúnen las fichas ya existentes para decidir según el hambre, el ambiente y la energía que tengáis.</p></header>{groups.map((group,index)=><section class:list={['food-group',{featured:index===0}]}><div class="food-group__heading"><p class="eyebrow">{group.eyebrow}</p><h3>{group.title}</h3><p>{group.copy}</p></div><div class="food-options">{group.ids.map(id=>{const restaurant=find(id);const note=group.notes[id];return restaurant&&<article class:list={['food-option',{primary:group.ids.indexOf(id)===0}]}><div><p class="food-option__zone">{restaurant.zone}</p><h4>{restaurant.name}</h4><p>{note}</p>{restaurant.price!=='Pendiente'&&<small>Precio orientativo: {restaurant.priceForFive??restaurant.price} · comprobar antes de pedir.</small>}</div><nav aria-label={`Enlaces de ${restaurant.name}`}><a href={`/restaurantes/${restaurant.id}/`}>Ficha completa</a><a href={restaurant.maps!} target="_blank" rel="noreferrer">Google Maps ↗</a>{restaurant.website&&<a href={restaurant.website} target="_blank" rel="noreferrer">Web ↗</a>}{restaurant.menu&&<a href={restaurant.menu} target="_blank" rel="noreferrer">Carta ↗</a>}</nav></article>})}</div>{index===1&&<aside class="street-food"><h4>Puestos de Jemaa el-Fna</h4><p>Experiencia opcional: escoged puestos con rotación, cocina a la vista y comida recién preparada. Observad primero, evitad comprometeros con insistencias y mantened las expectativas de higiene realistas.</p></aside>}</section>)}<section class="evening-plans"><p class="eyebrow">Tres maneras de disfrutarlo</p><h3>Planes abiertos, no itinerarios rígidos</h3><div><article class="plan-a"><p>Opción preferente</p><h4>Plan A · Marrakech auténtico</h4><p>Zocos, degustación opcional en Chez Hicham, té en Amornakoch, Jemaa el-Fna, cena en Taj’in Darna o El Bahja y última bebida en El Fenn o La Pergola.</p></article><article><h4>Plan B · Marrakech sofisticado</h4><p>Zocos, cena al atardecer en Coco Rooftop, paseo por la plaza y bebidas en El Fenn.</p></article><article><h4>Plan C · Marrakech contemporáneo</h4><p>Medina sin prisa, azotea al atardecer, cena en L’Mida y ambiente musical en La Pergola.</p></article></div></section></section>
<style>.evening-food{padding:clamp(3rem,6vw,5rem) max(1rem,calc((100% - 1100px)/2));background:#fff;color:#293342}.evening-food>header{max-width:720px;margin-bottom:2.4rem}.evening-food .eyebrow{color:#9a5638}.evening-food h2,.evening-food h3,.evening-food h4{color:#3e2432}.evening-food h2{margin:.3rem 0;font-size:clamp(2rem,4vw,3.6rem)}.evening-food>header>p:last-child{line-height:1.6;color:#5f6775}.food-group{margin:3rem 0}.food-group__heading{display:grid;grid-template-columns:minmax(200px,.7fr) minmax(0,1.3fr);gap:1.5rem;align-items:end;margin-bottom:1rem}.food-group__heading h3{margin:.2rem 0;font-size:clamp(1.55rem,3vw,2.4rem)}.food-group__heading>p:last-child{margin:0;line-height:1.55;color:#5f6775}.food-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:#e3d7d2}.food-option{display:flex;flex-direction:column;justify-content:space-between;gap:1rem;padding:1.25rem;background:#fff8f5;border-top:3px solid transparent}.food-option.primary{background:#f9eee8;border-top-color:#a85d40}.food-option__zone{margin:0;color:#9a5638;font-size:.76rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.food-option h4{margin:.35rem 0;font-size:1.35rem}.food-option p:not(.food-option__zone){margin:.35rem 0;line-height:1.5}.food-option small{color:#5f6775}.food-option nav{display:flex;gap:.65rem;flex-wrap:wrap}.food-option a{font-size:.84rem;font-weight:800;color:#6d3540;text-decoration:underline;text-underline-offset:3px}.food-option a:focus-visible{outline:3px solid #a85d40;outline-offset:3px}.street-food{margin-top:1px;padding:1.1rem 1.25rem;background:#2f2434;color:#fff}.street-food h4{margin:0;color:#f3c6a7}.street-food p{max-width:70ch;margin:.45rem 0 0;line-height:1.55}.evening-plans{margin-top:4rem;padding:clamp(1.5rem,4vw,2.5rem);background:#f6f0f4}.evening-plans h3{margin:.25rem 0 1.2rem;font-size:clamp(1.5rem,3vw,2.3rem)}.evening-plans>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:#decbd0}.evening-plans article{padding:1.2rem;background:#fff}.evening-plans .plan-a{background:#713c46;color:#fff}.evening-plans .plan-a h4{color:#fff}.evening-plans .plan-a>p:first-child{color:#f3c6a7;font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.evening-plans h4{margin:0;color:#3e2432}.evening-plans article>p:last-child{line-height:1.55}@media(max-width:720px){.food-group__heading,.food-options,.evening-plans>div{grid-template-columns:1fr}.food-group{margin:2.2rem 0}.food-option{padding:1rem}.evening-plans{margin-left:-1rem;margin-right:-1rem}}</style>
