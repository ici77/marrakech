---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { monuments, destinations } from '../../data/trip'; import PriorityBadge from '../../components/ui/PriorityBadge.astro';
---
<BaseLayout title="Monumentos"><section class="page-intro"><p class="eyebrow">Guía cultural</p><h1>Monumentos</h1><p>Catálogo filtrable de visitas y fichas culturales.</p></section><section class="section"><div class="filters" data-filter-root><label>Destino <select data-filter="destination"><option value="">Todos</option>{destinations.map(d=><option value={d.id}>{d.name}</option>)}</select></label><label>Prioridad <select data-filter="priority"><option value="">Todas</option><option value="essential">Imprescindible</option><option value="recommended">Recomendable</option></select></label></div><div class="catalog">{monuments.map(m => <article class="catalog-card" data-destination={m.destinationId} data-priority={m.priority}><PriorityBadge priority={m.priority}/><h2>{m.name}</h2><p>{m.cultural}</p><dl><div><dt>Horario</dt><dd>{m.openingHours}</dd></div><div><dt>Duración</dt><dd>{m.duration}</dd></div></dl><a class="text-link" href={`/monumentos/${m.id}/`}>Abrir ficha cultural →</a></article>)}</div></section></BaseLayout>
