---
import type { CircuitDayGuide } from '../../data/circuit-guide';
interface Props { guide:CircuitDayGuide }
const { guide }=Astro.props;
const tagClass=(tag:string)=>tag.includes('Incluido')?'included':tag.includes('opcional')?'optional':tag.includes('Pendiente')?'pending':'proposal';
const hasDesertCalculator=guide.route.includes('entorno de Erg Chebbi');
---
<section class="circuit-overview" aria-label="Resumen del circuito"><div><span>Recorrido</span><b>{guide.route}</b></div><div><span>Distancia</span><b>{guide.distance}</b></div><div><span>Conducción</span><b>{guide.driving}</b></div><div><span>Jornada completa</span><b>{guide.duration}</b></div></section>
<section class="circuit-section"><p class="eyebrow">La ruta, con contexto</p><h2>Lugares que vamos a descubrir</h2><div class="circuit-stops">{guide.stops.map(stop=><article><div class="stop-meta"><span class={`tag ${tagClass(stop.tag)}`}>{stop.tag}</span><span>Prioridad {stop.priority} · {stop.priority===1?'Imprescindible':stop.priority===2?'Recomendable':'Prescindible si falta tiempo'}</span></div><h3>{stop.title}</h3><p>{stop.text}</p>{stop.advice&&<p class="advice"><b>Consejo:</b> {stop.advice}</p>}<a href={stop.map} target="_blank" rel="noreferrer">Ver ubicación ↗</a></article>)}</div></section>
<section class="circuit-section circuit-timing"><p class="eyebrow">Cronograma orientativo</p><h2>Cómo se organiza el día</h2><ol>{guide.timeline.map(item=><li><time>{item.time}</time><div><h3>{item.title}</h3><p>{item.text}</p></div></li>)}</ol></section>
<section class="circuit-section circuit-logistics"><div><p class="eyebrow">Alojamiento</p><h2>{guide.accommodation}</h2><p>{guide.accommodationNote}</p></div><div><p class="eyebrow">Comidas incluidas</p><ul>{guide.meals.map(item=><li>{item}</li>)}</ul></div><div><p class="eyebrow">Cubierto por el circuito</p><ul>{guide.covered.map(item=><li>{item}</li>)}</ul></div><div><p class="eyebrow">Gastos adicionales</p><ul>{guide.extra.map(item=><li>{item}</li>)}</ul></div></section>
<section class="circuit-practical"><p class="eyebrow">Consejos prácticos</p><ul>{guide.practical.map(item=><li>{item}</li>)}</ul><p><a href="/reservas/#circuito">Consultar la reserva del circuito Morocco Camel Trekking →</a></p></section>
{hasDesertCalculator && <section class="optional-calculator"><p class="eyebrow">Actividad opcional · no reservada</p><h2>Calculadora de quad y buggy</h2><p>Importes orientativos comunicados por la agencia. Confirma plazas, edades y seguridad antes de contratar.</p><div><label>Quad individual · 40 €/persona/h<input type="number" min="0" value="0" data-rate="40" /></label><label>Quad compartido · 60 €/vehículo/h<input type="number" min="0" value="0" data-rate="60" /></label><label>Buggy · 120 €/vehículo/h<input type="number" min="0" value="0" data-rate="120" /></label></div><p class="calculator-total">Total opcional: <b data-total>0,00 €</b></p></section>}
<style>.circuit-overview{max-width:1100px;margin:0 auto;padding:1rem clamp(1rem,4vw,3rem);display:grid;grid-template-columns:2fr repeat(3,1fr);gap:1px;background:var(--line)}.circuit-overview div{display:grid;gap:.35rem;padding:1rem;background:var(--white)}.circuit-overview span,.stop-meta,.tag{font-size:.76rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase}.circuit-overview span{color:var(--terra)}.circuit-section{max-width:1100px;margin:0 auto;padding:clamp(2.5rem,5vw,4.5rem) clamp(1rem,4vw,3rem)}.circuit-section h2{margin-top:.3rem}.circuit-stops{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--line)}.circuit-stops article{padding:1.3rem;background:var(--sand)}.stop-meta{display:flex;justify-content:space-between;gap:.6rem;align-items:start;color:var(--muted)}.tag{padding:.3rem .45rem;background:#dceae5;color:var(--deep)}.tag.optional{background:#f4e4bd;color:#73480d}.tag.pending{background:#eee5dc;color:#62554a}.tag.proposal{background:#eee6f4;color:#56366f}.circuit-stops h3{margin:.8rem 0 .45rem}.circuit-stops a{font-weight:700}.advice{padding:.65rem;background:#fff}.circuit-timing{background:var(--beige);max-width:none;padding-left:max(1rem,calc((100% - 1040px)/2));padding-right:max(1rem,calc((100% - 1040px)/2))}.circuit-timing ol{padding:0;margin:1.5rem 0 0;list-style:none}.circuit-timing li{display:grid;grid-template-columns:150px 1fr;gap:1rem;padding:0 0 1.3rem}.circuit-timing time{font-weight:800;color:var(--terra)}.circuit-timing li>div{padding-left:1rem;border-left:2px solid var(--gold)}.circuit-timing h3{margin:0}.circuit-timing p{margin:.35rem 0}.circuit-logistics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem 3rem}.circuit-logistics h2{font-size:clamp(1.45rem,2.4vw,2.2rem)}.circuit-logistics ul,.circuit-practical ul{padding-left:1.2rem}.circuit-practical{padding:clamp(2rem,4vw,3rem) max(1rem,calc((100% - 1040px)/2));background:var(--deep);color:#fff}.circuit-practical .eyebrow{color:var(--gold)}.circuit-practical a{color:#fff;font-weight:800}.optional-calculator{max-width:1040px;margin:3rem auto;padding:1.5rem clamp(1rem,4vw,3rem);background:var(--sand);border-top:3px solid var(--gold)}.optional-calculator h2{margin:.25rem 0}.optional-calculator>div{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.optional-calculator label{display:grid;gap:.4rem;font-weight:700}.optional-calculator input{max-width:100%;padding:.55rem;border:1px solid var(--line);font:inherit}.calculator-total{font-size:1.15rem}@media(max-width:700px){.circuit-overview{grid-template-columns:1fr 1fr}.circuit-overview div:first-child{grid-column:span 2}.circuit-stops,.circuit-logistics,.optional-calculator>div{grid-template-columns:1fr}.circuit-timing li{grid-template-columns:1fr;gap:.4rem}.circuit-timing li>div{margin-left:.2rem}}</style>
{hasDesertCalculator && <script>document.querySelectorAll<HTMLElement>('.optional-calculator').forEach(root=>{const render=()=>{const total=[...root.querySelectorAll<HTMLInputElement>('[data-rate]')].reduce((sum,input)=>sum+Number(input.value||0)*Number(input.dataset.rate),0);const output=root.querySelector<HTMLElement>('[data-total]');if(output)output.textContent=total.toLocaleString('es-ES',{style:'currency',currency:'EUR'});};root.querySelectorAll<HTMLInputElement>('[data-rate]').forEach(input=>input.addEventListener('input',render));render();});</script>}
