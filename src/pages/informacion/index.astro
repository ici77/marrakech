---
import BaseLayout from '../../layouts/BaseLayout.astro';
const practical = [['Documentación','Pasaportes, billetes y seguros accesibles sin depender del correo. No se guardan documentos personales en esta guía.'],['Moneda y pagos','Lleva una combinación de efectivo y tarjeta. El presupuesto utiliza 10,60 MAD por euro solo como referencia de planificación.'],['Conectividad','Comprueba roaming, eSIM o tarjeta local y conserva lo esencial disponible offline.'],['Equipaje','Capas para los amaneceres, calzado cómodo y chaqueta para las noches.'],['Respeto cultural','Vestimenta cómoda y respetuosa en espacios religiosos; solicita permiso antes de fotografiar personas.'],['Durante el viaje','Consulta reservas, pagos y jornadas desde la guía; registra progreso y gastos reales en este dispositivo.']];
---
<BaseLayout title="Información práctica"><section class="page-intro"><p class="eyebrow">Preparativos</p><h1>Información práctica</h1><p>Una guía breve para preparar el viaje y utilizar la aplicación sin depender de los correos de reserva.</p></section><section class="section practical-grid">{practical.map(([title,text],index)=><article><span>{String(index+1).padStart(2,'0')}</span><h2>{title}</h2><p>{text}</p><label><input type="checkbox" data-check={index}/><b>Revisado</b></label></article>)}</section></BaseLayout>
<style>.practical-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.practical-grid article{padding:1.4rem;background:var(--color-surface);border-top:3px solid var(--color-accent);box-shadow:var(--shadow-sm)}.practical-grid span{font:1.5rem var(--font-serif);color:var(--color-primary)}.practical-grid h2{margin:.3rem 0;font-size:1.55rem}.practical-grid p{color:var(--color-text-muted)}.practical-grid label{display:flex;gap:.5rem;align-items:center;margin-top:1rem;font-size:.85rem}@media(max-width:800px){.practical-grid{grid-template-columns:1fr}}</style>
