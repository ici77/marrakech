---
import type { TripDay } from '../../types/travel';
import { itineraryImages } from '../../data/itinerary-images';
import { itineraryCardSummaries } from '../../data/itinerary-card-summaries';
import TravelImage from '../media/TravelImage.astro';
const {day}=Astro.props as {day:TripDay};
const image=itineraryImages[day.id]!;
const date=new Intl.DateTimeFormat('es-ES',{weekday:'long',day:'numeric',month:'short'}).format(new Date(`${day.date}T12:00:00`)).replace('.','').toLocaleUpperCase('es-ES');
const summary=itineraryCardSummaries[day.id]??day.summary;
---
<article class="day-card"><header class="day-card__header"><p>{date}</p><h3>{day.title}</h3></header><TravelImage image={image} class="day-card__media" loading="lazy" showCredit={false}/><div class="day-card__content"><p>{summary}</p><a class="day-card__cta" href={`/itinerario/${day.id}/`} aria-label={`Ver jornada: ${day.title}`}><span>Ver jornada</span><span aria-hidden="true">→</span></a></div></article>
<style>.day-card{display:flex;flex-direction:column;min-width:0;height:100%;overflow:hidden;background:var(--white);border:1px solid #e1e5eb;box-shadow:0 7px 18px #182f500c}.day-card__header{min-height:94px;padding:1rem 1rem .8rem}.day-card__header p{margin:0 0 .35rem;color:#956536;font-size:.72rem;font-weight:800;letter-spacing:.09em;line-height:1.2}.day-card__header h3{margin:0;color:#182f50;font-family:var(--font-serif);font-size:clamp(1.25rem,1.65vw,1.55rem);line-height:1.1}.day-card__media{display:block;aspect-ratio:16/9;overflow:hidden;flex:none}.day-card__media :global(img){display:block;width:100%;height:100%;object-fit:cover;object-position:center}.day-card__content{display:flex;flex:1;flex-direction:column;gap:1rem;padding:1rem}.day-card__content>p{margin:0;color:#566273;font-size:.92rem;line-height:1.5}.day-card__cta{display:flex;align-items:center;justify-content:space-between;min-height:44px;padding:.65rem .8rem;margin-top:auto;border-radius:6px;background:#20374e;color:#fff;font-size:.9rem;font-weight:800;text-decoration:none;transition:background-color .18s ease,transform .18s ease}.day-card__cta:hover{background:#182f50;transform:translateY(-1px)}.day-card__cta:focus-visible{outline:3px solid #956536;outline-offset:3px}@media(max-width:600px){.day-card__header{min-height:auto}.day-card__header h3{font-size:1.35rem}}</style>
