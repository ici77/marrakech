---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { reservations } from '../../data/trip';
import { itineraryImages } from '../../data/itinerary-images';
import ReservationStatus from '../../components/ui/ReservationStatus.astro';
import TravelImage from '../../components/media/TravelImage.astro';
const confirmed=reservations.filter(item=>['confirmed','paid','pending_payment'].includes(item.status));
const charges=reservations.filter(item=>item.paymentDate&&item.pendingAmount).sort((a,b)=>a.paymentDate!.localeCompare(b.paymentDate!));
const privatePrice='XXXX';
const redactPrice=(value:string)=>value.replace(/\d[\d.,\s]*(?:[–-]\s*\d[\d.,\s]*)?\s*(?:€|EUR|MAD)/gi,privatePrice);
---
<BaseLayout title="Reservas">
  <section class="page-intro reservation-intro"><p class="eyebrow">Todo en un lugar</p><h1>Reservas del viaje</h1><p>Detalles operativos disponibles sin conexión. Los importes se han ocultado en esta edición de la guía.</p></section>
  <section class="reservation-summary" aria-label="Resumen económico oculto"><article><span>Confirmado con importe</span><strong>{privatePrice}</strong></article><article><span>Pagado</span><strong>{privatePrice}</strong></article><article><span>Pendiente</span><strong>{privatePrice}</strong></article><article><span>Reservas confirmadas</span><strong>{confirmed.length}</strong></article></section>
  {charges.length>0&&<section class="section charges"><p class="eyebrow">Atención</p><h2>Próximos cargos</h2><div>{charges.map(item=><article data-charge={item.id}><time>{new Intl.DateTimeFormat('es-ES',{day:'numeric',month:'long'}).format(new Date(`${item.paymentDate}T12:00:00`))}</time><b>{item.title}</b><span>{privatePrice}</span></article>)}</div></section>}
  <section class="section reservation-list" data-reservation-root><div class="reservation-filters" role="group" aria-label="Filtrar reservas"><button data-filter="all" aria-pressed="true">Todas</button><button data-filter="Actividad">Actividades</button><button data-filter="Restaurante">Restaurantes</button><button data-filter="Alojamiento">Alojamientos</button><button data-filter="Traslado">Transportes</button><button data-filter="pending">Pendientes de pago</button></div><div class="reservation-cards">{reservations.map(item=><article id={item.id} class="reservation-detail" data-category={item.category} data-pending={item.status==='pending_payment'||item.pendingAmount?'true':'false'}>
    {item.dayId&&itineraryImages[item.dayId]&&<TravelImage image={itineraryImages[item.dayId]!} class="reservation-image" loading="lazy" showCredit={false}/>}<div class="reservation-content"><div class="reservation-heading"><div><p class="eyebrow">{item.category} · {new Intl.DateTimeFormat('es-ES',{weekday:'long',day:'numeric',month:'long'}).format(new Date(`${item.date}T12:00:00`))}</p>{item.editorialTitle&&<p class="editorial-title">{item.editorialTitle}</p>}<h2>{item.title}</h2></div><ReservationStatus status={item.status}/></div><p>{redactPrice(item.note)}</p><div class="reservation-facts"><span>◷ {item.startTime??'Horario por confirmar'}</span>{item.duration&&<span>◴ {item.duration}</span>}<span>♟ {item.travelers} participantes</span>{item.language&&<span>◎ {item.language}</span>}{item.amount&&<span>▣ {privatePrice}</span>}{item.originalAmount&&<span class="saving">Precio y ahorro: {privatePrice}</span>}</div><div class="transport"><b>⌖ Transporte</b><span>{item.pickupIncluded?`Recogida incluida${item.pickupPlace?` · ${item.pickupPlace}`:''}`:item.meetingPoint??item.address??'Sin recogida incluida; organizar desplazamiento.'}</span>{item.returnIncluded&&<span> · Regreso incluido</span>}</div>
    <details><summary>Ver detalles operativos</summary><div class="reservation-extra">{item.arrivalTime&&<p><b>Hora recomendada de llegada:</b> {item.arrivalTime}</p>}{item.priceNote&&<p><b>Precio:</b> {privatePrice}</p>}{item.pricePerPerson&&<p><b>Precio por persona:</b> {privatePrice}</p>}{item.pickupStatus==='to_verify'&&<p><b>Recogida:</b> hora pendiente de confirmar por el proveedor.</p>}{item.address&&<p><b>Dirección:</b> {item.address}</p>}{item.endMeetingPoint&&<p><b>Finalización:</b> {item.endMeetingPoint}</p>}{item.mapsUrl&&<p><a href={item.mapsUrl} target="_blank" rel="noreferrer">Abrir ubicación en Google Maps ↗</a></p>}{item.phone&&<p><b>Teléfono público:</b> <a href={`tel:${item.phone.replaceAll(' ','')}`}>{item.phone}</a></p>}{item.schedule&&<div class="evening-program"><b>Programa de la velada</b><ol>{item.schedule.map(event=><li><time>{event.time}</time><span>{event.label}</span></li>)}</ol></div>}{item.included&&<div><b>✓ Incluye</b><ul>{item.included.map(value=><li>{redactPrice(value)}</li>)}</ul></div>}{item.excluded&&<div><b>No incluido</b><ul>{item.excluded.map(value=><li>{redactPrice(value)}</li>)}</ul></div>}{item.bring&&<div><b>⌂ Qué llevar</b><ul>{item.bring.map(value=><li>{redactPrice(value)}</li>)}</ul></div>}{item.important&&<div><b>Información importante</b><ul>{item.important.map(value=><li>{redactPrice(value)}</li>)}</ul></div>}{item.pending&&<div class="pending-note"><b>Pendiente de confirmar</b><ul>{item.pending.map(value=><li>{redactPrice(value)}</li>)}</ul></div>}{item.cancellation&&<p><b>▣ Cancelación:</b> {item.cancellation}</p>}{item.source&&<p><small>Fuente: {item.source}</small></p>}</div></details>
    {(item.paidAmount||item.pendingAmount)&&<div class="payment-line"><span>{item.paidAmount&&<>▣ Anticipo abonado: <b>{privatePrice}</b><br/></>}{item.pendingAmount&&<>▣ Saldo pendiente: <b>{privatePrice}</b>{item.paymentDate&&` · cargo previsto ${new Intl.DateTimeFormat('es-ES',{day:'numeric',month:'long'}).format(new Date(`${item.paymentDate}T12:00:00`))}`}</>}</span>{item.pendingAmount&&<button data-payment={item.id}>Marcar como pagado</button>}</div>}
  </div></article>)}</div></section>
</BaseLayout>
<script>// @ts-nocheck
const root=document.querySelector('[data-reservation-root]');const key='marruecos-2026:reservation-payments:v1';const paid=()=>JSON.parse(localStorage.getItem(key)||'[]');const render=()=>{const done=new Set(paid());document.querySelectorAll('[data-payment]').forEach(button=>{const complete=done.has(button.dataset.payment);button.textContent=complete?'Pago registrado ✓':'Marcar como pagado';button.setAttribute('aria-pressed',String(complete));const charge=document.querySelector(`[data-charge="${button.dataset.payment}"]`);if(charge)charge.toggleAttribute('hidden',complete)});};root?.querySelectorAll('[data-filter]').forEach(button=>button.addEventListener('click',()=>{root.querySelectorAll('[data-filter]').forEach(item=>item.setAttribute('aria-pressed','false'));button.setAttribute('aria-pressed','true');const filter=button.dataset.filter;root.querySelectorAll('[data-category]').forEach(card=>{const visible=filter==='all'||(filter==='pending'?card.dataset.pending==='true':card.dataset.category===filter);card.toggleAttribute('hidden',!visible)})}));document.querySelectorAll('[data-payment]').forEach(button=>button.addEventListener('click',()=>{const set=new Set(paid());set.has(button.dataset.payment)?set.delete(button.dataset.payment):set.add(button.dataset.payment);localStorage.setItem(key,JSON.stringify([...set]));render()}));render();</script>
<style>.reservation-intro{max-width:840px}.reservation-summary{max-width:1180px;margin:0 auto;padding:0 clamp(1rem,4vw,3rem);display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--color-border)}.reservation-summary article{padding:1.1rem;background:var(--color-surface)}.reservation-summary span{display:block;font-size:.78rem;color:var(--color-text-muted)}.reservation-summary strong{font:clamp(1.35rem,2.5vw,2.2rem) var(--font-serif);color:var(--color-primary)}.charges{padding-top:2.5rem;padding-bottom:1rem}.charges>div{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:.7rem}.charges article{display:grid;grid-template-columns:auto 1fr auto;gap:.7rem;align-items:center;padding:.9rem;background:var(--color-warning-bg);border-left:3px solid var(--color-warning)}.charges time{font-weight:800;color:var(--color-warning)}.reservation-filters{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1.2rem}.reservation-filters button{padding:.55rem .75rem;border:1px solid var(--color-border);background:var(--color-surface);cursor:pointer}.reservation-filters button[aria-pressed="true"]{background:var(--color-secondary);border-color:var(--color-secondary);color:#fff}.reservation-cards{display:grid;gap:1.2rem}.reservation-detail{display:grid;grid-template-columns:260px 1fr;overflow:hidden;background:var(--color-surface);border:1px solid var(--color-border);box-shadow:var(--shadow-sm)}.reservation-image{min-height:100%;height:100%}.reservation-image :global(img){height:100%;min-height:250px}.reservation-content{padding:1.3rem}.reservation-heading{display:flex;justify-content:space-between;gap:1rem}.reservation-heading h2{margin:.2rem 0}.reservation-facts{display:flex;gap:.5rem;flex-wrap:wrap;margin:1rem 0}.reservation-facts span,.transport{padding:.38rem .55rem;background:var(--color-background);font-size:.86rem}.transport{display:block;border-left:3px solid var(--color-accent)}details{margin-top:1rem;border-top:1px solid var(--color-border);padding-top:.75rem}summary{font-weight:750;color:var(--color-link)}.reservation-extra{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.4rem 1.5rem;padding-top:.75rem}.reservation-extra p,.reservation-extra div{margin:0}.reservation-extra ul{margin:.25rem 0;padding-left:1.1rem}.pending-note{padding:.6rem;background:var(--color-warning-bg)}.payment-line{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-top:1rem;padding-top:1rem;border-top:1px solid var(--color-border)}.payment-line button{padding:.55rem .75rem;border:1px solid var(--color-primary);background:var(--color-primary);color:#fff;cursor:pointer}.payment-line button[aria-pressed="true"]{background:var(--color-success);border-color:var(--color-success)}@media(max-width:700px){.reservation-summary{grid-template-columns:repeat(2,1fr)}.reservation-detail{grid-template-columns:1fr}.reservation-image{height:180px}.reservation-image :global(img){min-height:180px}.reservation-heading,.payment-line{display:block}.reservation-heading .badge{margin-top:.5rem}.reservation-extra{grid-template-columns:1fr}.payment-line button{margin-top:.7rem;width:100%}}</style>
