---
import type { ItineraryImage } from '../../data/itinerary-images';
interface Props { image: ItineraryImage }
const { image } = Astro.props;
---
<div class="itinerary-image"><img src={image.url} alt={image.description} referrerpolicy="no-referrer" /></div>
<style>
  .itinerary-image{position:absolute;inset:0;overflow:hidden}
  .itinerary-image img{width:100%;height:100%;object-fit:cover}
  .itinerary-image::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(24,61,53,.92),rgba(24,61,53,.3))}
</style>
