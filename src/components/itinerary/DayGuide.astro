---
import type { Destination, MarrakechRestaurant, Monument, Reservation, TripDay } from '../../types/travel';
import PriorityBadge from '../ui/PriorityBadge.astro';
import ReservationStatus from '../ui/ReservationStatus.astro';
import TravelImage from '../media/TravelImage.astro';
import type { ItineraryImage } from '../../data/itinerary-images';
import DailyRestaurants from './DailyRestaurants.astro';
import type { RestaurantRecommendation } from '../../types/travel';
interface Props { day: TripDay; destination: Destination | undefined; image?: ItineraryImage | undefined; reservations: Reservation[]; monuments: Monument[]; restaurants: MarrakechRestaurant[]; restaurantRecommendations:RestaurantRecommendation[] }
const { day, destination, image, reservations, monuments, restaurants, restaurantRecommendations } = Astro.props;
const standoutCategories = new Set(['Restaurante', 'Espectáculo', 'Experiencia', 'Excursión', 'Hammam']);
const scoredActivities = day.activities.filter((activity) => activity.priority === 'essential').map((activity) => {
  const reservation = reservations.find((item) => item.id === activity.reservationId);
  return { activity, score: reservation && standoutCategories.has(reservation.category) ? 2 : reservation ? 1 : 0 };
});
const essential = scoredActivities.filter((item) => item.score === 2).map((item) => item.activity).slice(0, 3);
const fallbackEssential = day.activities.filter((activity) => activity.priority === 'essential').sort((a, b) => {
  const aReservation = reservations.find((reservation) => reservation.id === a.reservationId);
  const bReservation = reservations.find((reservation) => reservation.id === b.reservationId);
  const score = (reservation: typeof aReservation) => reservation && standoutCategories.has(reservation.category) ? 2 : reservation ? 1 : 0;
  return score(bReservation) - score(aReservation);
}).slice(0, 3);
const featuredActivities = essential.length ? essential : fallbackEssential;
const hasReservations = reservations.length > 0;
const hasMonuments = monuments.length > 0;
const hasRestaurants = restaurantRecommendations.length > 0;
const heroImage = destination?.image ?? '/images/marrakech.svg';
const prettyDate = new Intl.DateTimeFormat('es-ES',{weekday:'long',day:'numeric',month:'long'}).format(new Date(`${day.date}T12:00:00`));
---
<section class="guide-hero" style={`background-image:linear-gradient(90deg,rgba(24,61,53,.92),rgba(24,61,53,.22)),url('${heroImage}')`}>{image && <TravelImage image={image} class="guide-hero-photo" priority={true} showCredit={true} />}<div class="guide-hero-content"><p class="eyebrow">{prettyDate} · {destination?.name}</p><h1>{day.title}</h1><p>{day.summary}</p><div class="guide-meta"><span>⌂ {day.accommodation}</span><span>{day.zone ?? 'Planificación de jornada'}</span><span>◷ 5 viajeros</span></div></div></section>
<nav class="guide-toc" aria-label="Índice de jornada">{hasReservations && <a href="#reservas">Reservas</a>}<a href="#planning">Planning</a>{hasMonuments && <a href="#cultura">Cultura</a>}{hasRestaurants && <a href="#comer">Comer</a>}</nav>
<section class="day-progress" data-day-progress data-activity-ids={day.activities.map(activity=>activity.id).join(',')}><div><b>Progreso de la jornada</b><span data-progress-label>0 realizadas · 0 omitidas · {day.activities.length} pendientes</span></div><div class="day-progress-track"><span data-progress-bar></span></div></section>
{hasReservations && <section class="guide-section" id="reservas"><p class="eyebrow">No perder de vista</p><h2>Reservas y servicios</h2><div class="guide-reservations">{reservations.map(reservation => <article><ReservationStatus status={reservation.status}/><h3>{reservation.title}</h3><p><b>{reservation.date}</b> · {reservation.travelers} viajeros</p><p>{reservation.note}</p>{reservation.amount && <p class="amount">{(reservation.amount.amount/100).toLocaleString('es-ES',{minimumFractionDigits:2})} {reservation.amount.currency}</p>}</article>)}</div></section>}
<section class="guide-section guide-priorities"><div class="priority-heading"><div><p class="eyebrow">Momentos clave</p><h2>Las experiencias que hacen especial este día</h2></div><p>Una selección breve de lo que realmente define la jornada.</p></div><div class="priority-grid">{featuredActivities.length ? featuredActivities.map((activity,index) => <article><div class="priority-card-top"><span class="priority-number">{String(index+1).padStart(2,'0')}</span><PriorityBadge priority={activity.priority}/></div><h3>{activity.title}</h3><p>{activity.description}</p></article>) : <article><p>La jornada depende de servicios que aún deben formalizarse. Consulta el planning y los estados de reserva.</p></article>}</div></section>
<section class="guide-section" id="planning"><p class="eyebrow">El día, paso a paso</p><h2>Planning cronológico</h2><ol class="guide-timeline">{day.activities.map((activity,index) => <li data-progress-activity={activity.id}><time>{activity.start ?? 'Por fijar'}</time><div><span>{String(index+1).padStart(2,'0')}</span><h3>{activity.title}</h3><PriorityBadge priority={activity.priority}/><p>{activity.description}</p><small>{activity.status === 'confirmed' ? 'Hora prevista en planning; comprobar el estado de la reserva vinculada.' : 'Horario o actividad pendiente de confirmar.'}</small><div class="activity-actions"><label><input type="checkbox" data-activity-complete={activity.id}/> Realizada</label><button type="button" data-activity-skip={activity.id}>Omitir</button><button type="button" data-activity-reset={activity.id} hidden>Restablecer</button></div></div></li>)}</ol></section>
{hasMonuments && <section class="guide-section guide-culture" id="cultura"><p class="eyebrow">Guía de bolsillo</p><h2>Monumentos y paradas culturales</h2><div class="guide-monuments">{monuments.map(monument => <article><PriorityBadge priority={monument.priority}/><h3>{monument.name}</h3><dl><div><dt>Visita prevista</dt><dd>{monument.openingHours}</dd></div><div><dt>Referencia de precio</dt><dd>{monument.admission}</dd></div><div><dt>Duración</dt><dd>{monument.duration}</dd></div></dl><details><summary>Consultar ficha cultural</summary><p>{monument.cultural}</p><p>{monument.history}</p><p>{monument.architecture}</p><p>{monument.observe}</p><p>{monument.route}</p></details></article>)}</div></section>}
<DailyRestaurants recommendations={restaurantRecommendations} restaurants={restaurants}/>
<style>
 .guide-hero{position:relative;isolation:isolate;min-height:470px;display:grid;align-items:end;background-position:center;background-size:cover;color:#fff}.guide-hero :global(.guide-hero-photo){position:absolute;inset:0;z-index:0}.guide-hero :global(.guide-hero-photo::after){content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(24,61,53,.92),rgba(24,61,53,.3))}.guide-hero :global(.guide-hero-photo figcaption){position:absolute;right:1rem;bottom:1rem;z-index:1;max-width:min(430px,calc(100% - 2rem));padding:.35rem .5rem;margin:0;color:#fff;background:#183d35c9}.guide-hero-content{position:relative;z-index:1;max-width:850px;padding:clamp(2rem,7vw,6rem)}.guide-hero .eyebrow{color:var(--gold)}.guide-hero h1{font-size:clamp(2.8rem,7vw,6rem);margin:.4rem 0}.guide-meta{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:1.5rem}.guide-meta span{padding:.3rem .6rem;background:#183d35bd;border:1px solid #fff6;font-size:.82rem}.guide-toc{position:sticky;top:56px;z-index:4;display:flex;gap:1rem;overflow:auto;padding:.65rem max(1rem,calc((100% - 1100px)/2));background:var(--white);border-bottom:1px solid var(--line)}.guide-toc a{flex:none;font-size:.82rem;font-weight:700;text-decoration:none}.guide-section{max-width:1100px;margin:auto;padding:clamp(2.5rem,6vw,5rem) clamp(1rem,4vw,3rem)}.guide-reservations,.guide-monuments,.guide-food{display:grid;gap:1rem}.guide-reservations{grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}.guide-reservations article{padding:1.3rem;background:var(--deep);border-top:4px solid var(--gold);color:#fff}.guide-reservations h3{margin-top:1rem}.guide-reservations .amount{color:var(--gold);font-size:1.15rem;font-weight:700}.guide-priorities{max-width:none;background:var(--beige);padding-left:max(1rem,calc((100% - 1040px)/2));padding-right:max(1rem,calc((100% - 1040px)/2))}.guide-priorities>div{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.guide-priorities article{padding:1rem;border-top:1px solid #bba98c}.guide-timeline{padding:0;margin:2rem 0;list-style:none}.guide-timeline li{display:grid;grid-template-columns:130px 1fr;gap:1rem;padding-bottom:2rem}.guide-timeline time{color:var(--terra);font-weight:700}.guide-timeline li>div{position:relative;padding-left:1.4rem;border-left:1px solid var(--gold)}.guide-timeline li>div>span{position:absolute;left:-.6rem;top:0;width:1.2rem;height:1.2rem;border-radius:50%;background:var(--terra);color:#fff;text-align:center;font-size:.62rem;line-height:1.2rem}.guide-timeline h3{display:inline;margin-right:.5rem}.guide-timeline small{color:var(--muted)}.guide-culture{max-width:none;background:var(--white);padding-left:max(1rem,calc((100% - 1040px)/2));padding-right:max(1rem,calc((100% - 1040px)/2))}.guide-monuments{grid-template-columns:repeat(2,1fr)}.guide-monuments article{padding:1.3rem;background:var(--sand);border:1px solid var(--line)}.guide-monuments h3{margin-top:1rem}.guide-monuments dl{display:grid;gap:.6rem;grid-template-columns:repeat(3,1fr)}.guide-monuments details{margin-top:1rem;padding-top:.7rem;border-top:1px solid var(--line)}.guide-monuments summary{font-weight:700}.guide-food{grid-template-columns:repeat(3,1fr)}.guide-food article{padding:1.3rem;background:var(--beige)}.guide-food span{color:var(--terra);font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.guide-practical{max-width:none;background:var(--green);color:#fff;padding-left:max(1rem,calc((100% - 1040px)/2));padding-right:max(1rem,calc((100% - 1040px)/2))}.guide-practical .eyebrow{color:var(--gold)}.guide-practical>div{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#ffffff55}.guide-practical article{display:grid;gap:.5rem;padding:1rem;background:var(--green)}.guide-practical b{color:var(--gold)}.guide-practical a{color:#fff}@media(max-width:700px){.guide-hero{min-height:420px}.guide-toc{top:56px}.guide-priorities>div,.guide-monuments,.guide-food{grid-template-columns:1fr}.guide-timeline li{grid-template-columns:1fr;gap:.3rem}.guide-timeline li>div{margin-left:.25rem}.guide-monuments dl{grid-template-columns:1fr}.guide-practical>div{grid-template-columns:1fr 1fr}}
</style>
<style>.day-progress{max-width:1100px;margin:0 auto;padding:1rem clamp(1rem,4vw,3rem);display:grid;gap:.55rem;background:var(--white)}.day-progress>div:first-child{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}.day-progress-track{height:6px;background:var(--line)}.day-progress-track span{display:block;width:0;height:100%;background:var(--green);transition:width .2s}.activity-actions{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;margin-top:.8rem}.activity-actions label,.activity-actions button{font:inherit;font-size:.82rem;padding:.35rem .5rem;border:1px solid var(--line);background:var(--white);cursor:pointer}.guide-timeline li[data-state="completed"]>div{opacity:.65}.guide-timeline li[data-state="completed"] h3{text-decoration:line-through}.guide-timeline li[data-state="skipped"]>div{opacity:.55}@media(max-width:700px){.day-progress>div:first-child{display:grid}}</style>
<script>
// @ts-nocheck
import { dayProgress, readProgress, setProgressState } from '../../lib/trip-progress';
const renderProgress=()=>{document.querySelectorAll('[data-day-progress]').forEach(root=>{const ids=root.dataset.activityIds.split(',').filter(Boolean);const value=dayProgress(ids);root.querySelector('[data-progress-label]').textContent=`${value.completed} realizadas · ${value.skipped} omitidas · ${value.pending} pendientes`;root.querySelector('[data-progress-bar]').style.width=`${value.percent}%`;ids.forEach(id=>{const state=readProgress().activities[id]?.state||'pending';const item=document.querySelector(`[data-progress-activity="${id}"]`);if(!item)return;item.dataset.state=state;item.querySelector('[data-activity-complete]').checked=state==='completed';item.querySelector('[data-activity-skip]').hidden=state!=='pending';item.querySelector('[data-activity-reset]').hidden=state==='pending';});});};document.querySelectorAll('[data-activity-complete]').forEach(control=>control.addEventListener('change',()=>{setProgressState('activities',control.dataset.activityComplete,control.checked?'completed':'pending');renderProgress()}));document.querySelectorAll('[data-activity-skip]').forEach(button=>button.addEventListener('click',()=>{setProgressState('activities',button.dataset.activitySkip,'skipped');renderProgress()}));document.querySelectorAll('[data-activity-reset]').forEach(button=>button.addEventListener('click',()=>{setProgressState('activities',button.dataset.activityReset,'pending');renderProgress()}));window.addEventListener('trip-progress-change',renderProgress);window.addEventListener('storage',event=>{if(event.key==='marruecos-2026:progress:v1')renderProgress()});renderProgress();
</script>
