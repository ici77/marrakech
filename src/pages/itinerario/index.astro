---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { days,reservations } from '../../data/trip';
import DayCard from '../../components/itinerary/DayCard.astro';
import CurrentDayBanner from '../../components/itinerary/CurrentDayBanner.astro';
import { itineraryImages } from '../../data/itinerary-images';
import TravelImage from '../../components/media/TravelImage.astro';
const stages=[
  {id:'marrakech',title:'Marrakech',range:'19–22 de diciembre',text:'Palacios, zocos, jardines, gastronomía y experiencias.',items:days.slice(0,4)},
  {id:'atlas',title:'Atlas y Sáhara',range:'23–27 de diciembre',text:'Kasbahs, gargantas, Navidad entre dunas y la ruta hacia Fez.',items:days.slice(4,9)},
  {id:'norte',title:'Fez y el norte',range:'28–30 de diciembre',text:'Medinas históricas, la ciudad azul y el regreso.',items:days.slice(9)}
] as const;
---
<BaseLayout title="Nuestro itinerario"><section class="itinerary-hero"><TravelImage image={itineraryImages['23-diciembre']!} class="itinerary-hero-image" priority={true} showCredit={false}/><div><p class="eyebrow">19–30 de diciembre de 2026</p><h1>Nuestro itinerario</h1><p>Doce jornadas, tres paisajes y una ruta pensada para viajar sin prisas.</p><span>12 días · 11 noches · 5 viajeros</span></div></section><nav class="stage-nav" aria-label="Etapas del viaje">{stages.map(stage=><a href={`#${stage.id}`}>{stage.title}<span>{stage.range}</span></a>)}</nav><CurrentDayBanner days={days} reservations={reservations} images={itineraryImages}/><div class="itinerary-stages">{stages.map((stage,index)=><section class:list={['trip-stage',`trip-stage--${stage.id}`]} id={stage.id}><header class="stage-heading"><div><p>Capítulo 0{index+1} · {stage.range}</p><h2>{stage.title}</h2></div><p>{stage.text}</p></header><div class="journeys-grid">{stage.items.map(day=><DayCard day={day}/>)}</div></section>)}</div></BaseLayout>
<style>.itinerary-hero{position:relative;isolation:isolate;min-height:330px;display:grid;align-items:end;padding:clamp(2rem,5vw,4.5rem) max(1rem,calc((100% - 1280px)/2));color:#fff;background:#182f50}.itinerary-hero :global(.itinerary-hero-image){position:absolute;inset:0;z-index:-1}.itinerary-hero :global(.itinerary-hero-image::after){content:'';position:absolute;inset:0;background:linear-gradient(90deg,#182f50e8,#182f5055)}.itinerary-hero .eyebrow{color:#f1d39d}.itinerary-hero h1{margin:.25rem 0;font-size:clamp(2.6rem,5.5vw,5rem)}.itinerary-hero p:not(.eyebrow){max-width:550px;margin:.4rem 0 1rem;font-size:1.1rem}.itinerary-hero span{font-size:.82rem;font-weight:750;letter-spacing:.06em;text-transform:uppercase}.stage-nav{position:sticky;top:72px;z-index:5;display:flex;gap:.4rem;overflow:auto;padding:.7rem max(1rem,calc((100% - 1280px)/2));background:#fff;border-bottom:1px solid #e1e5eb}.stage-nav a{display:flex;gap:.45rem;align-items:baseline;flex:none;padding:.35rem .55rem;color:#20374e;font-size:.85rem;font-weight:800;text-decoration:none}.stage-nav a span{color:#697384;font-size:.72rem;font-weight:650}.stage-nav a:focus-visible{outline:3px solid #956536;outline-offset:2px}.itinerary-stages{max-width:1280px;margin:0 auto;padding:clamp(2.5rem,5vw,4.5rem) clamp(1rem,3vw,2rem)}.trip-stage{padding:0 0 clamp(2.8rem,5vw,4.5rem);margin-bottom:clamp(2.4rem,5vw,4rem);border-bottom:1px solid #e1e5eb}.trip-stage:last-child{margin-bottom:0;border:0}.stage-heading{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-bottom:1.25rem}.stage-heading>div>p{margin:0;color:#956536;font-size:.76rem;font-weight:850;letter-spacing:.09em;text-transform:uppercase}.stage-heading h2{margin:.25rem 0 0;color:#182f50;font-size:clamp(1.9rem,3.4vw,3rem);line-height:1.05}.stage-heading>p{max-width:430px;margin:0;color:#566273;line-height:1.5}.journeys-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:1.1rem;align-items:stretch}.trip-stage--atlas{padding-top:0}.trip-stage--atlas .stage-heading>div>p{color:#9a5638}.trip-stage--norte .stage-heading>div>p{color:#4d6295}@media(min-width:1500px){.journeys-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:900px){.stage-heading{display:block}.stage-heading>p{margin-top:.7rem}.stage-nav{top:56px}}@media(max-width:650px){.itinerary-hero{min-height:285px}.stage-nav a{padding:.3rem}.stage-nav a span{display:none}.itinerary-stages{padding-top:2rem}.trip-stage{margin-bottom:2.5rem;padding-bottom:2.5rem}.journeys-grid{grid-template-columns:1fr}}</style>
