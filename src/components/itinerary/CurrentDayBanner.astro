---
import type { Reservation, TripDay } from '../../types/travel';
import type { ItineraryImage } from '../../data/itinerary-images';
import TravelImage from '../media/TravelImage.astro';
interface Props { days: TripDay[]; reservations: Reservation[]; images: Record<string, ItineraryImage>; }
const { days, reservations, images } = Astro.props;
const initial = days[0]!;
const payload = JSON.stringify({days:days.map(day=>({id:day.id,date:day.date,title:day.title,zone:day.zone,summary:day.summary,accommodation:day.accommodation,activities:day.activities.slice(0,4).map(activity=>({title:activity.title,start:activity.start}))})),reservations:reservations.map(item=>({dayId:item.dayId,title:item.title,note:item.note})),images});
---
<section class="current-banner" data-current-day data-state={payload}><div class="current-banner-image"><TravelImage image={images[initial.id]!} class="current-photo" showCredit={false}/></div><div class="current-content"><p class="eyebrow" data-kicker>Nuestra aventura comienza</p><p class="current-number" data-number>Día 1 · 19 de diciembre</p><h2 data-title>{initial.title}</h2><p data-zone>{initial.zone}</p><p data-summary>{initial.summary}</p><div class="current-details"><div><b>Hoy</b><ul data-activities>{initial.activities.slice(0,4).map(activity=><li>{activity.start ? `${activity.start} · ` : ''}{activity.title}</li>)}</ul></div><div><b>Esta noche</b><p data-accommodation>{initial.accommodation}</p><p data-reservation>{reservations.find(item=>item.dayId===initial.id)?.title ?? 'Consulta el planning'}</p></div></div><div class="progress"><span data-progress style="width:8%"></span></div><a class="button" data-link href={`/itinerario/${initial.id}/`}>Descubrir nuestro primer día</a></div></section>
<script>
 // @ts-nocheck
 const root=document.querySelector('[data-current-day]'); if(root){const state=JSON.parse(root.dataset.state||'{}');const casablanca=()=>new Intl.DateTimeFormat('en-CA',{timeZone:'Africa/Casablanca',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()).replace(/\//g,'-');const set=(selector,value)=>{const node=root.querySelector(selector);if(node)node.textContent=value};const render=()=>{const today=casablanca();const first=state.days[0],last=state.days.at(-1);let day=state.days.find(item=>item.date===today)||first;let mode=today<first.date?'before':today>last.date?'after':'during';if(mode==='after'){set('[data-kicker]','Así fue nuestro viaje');set('[data-title]','El diario completo sigue disponible');set('[data-summary]','Vuelve a cualquier jornada, recuerdo y recomendación de la ruta.');set('[data-number]','19–30 de diciembre de 2026');root.querySelector('[data-activities]').innerHTML='';set('[data-accommodation]','Marruecos en familia');set('[data-reservation]','Gracias por viajar con nosotros');root.querySelector('[data-link]').textContent='Ver el itinerario completo';root.querySelector('[data-link]').href='/itinerario/';root.querySelector('[data-progress]').style.width='100%';return}const index=state.days.findIndex(item=>item.id===day.id);set('[data-kicker]',mode==='before'?`Nuestra aventura comienza en ${Math.max(1,Math.round((new Date(first.date)-new Date(today))/86400000))} días`:'Hoy nos toca…');set('[data-number]',`Día ${index+1} · ${new Intl.DateTimeFormat('es-ES',{timeZone:'Africa/Casablanca',weekday:'long',day:'numeric',month:'long'}).format(new Date(`${day.date}T12:00:00Z`))}`);set('[data-title]',day.title);set('[data-zone]',day.zone||'Marruecos');set('[data-summary]',day.summary);set('[data-accommodation]',day.accommodation);const reservation=state.reservations.find(item=>item.dayId===day.id);set('[data-reservation]',reservation?reservation.title:'Sin reserva destacada');root.querySelector('[data-activities]').innerHTML=day.activities.map(item=>`<li>${item.start?`${item.start} · `:''}${item.title}</li>`).join('');root.querySelector('[data-link]').href=`/itinerario/${day.id}/`;root.querySelector('[data-link]').textContent=mode==='before'?'Descubrir nuestro primer día':'Abrir la guía de hoy';root.querySelector('[data-progress]').style.width=`${((index+1)/state.days.length)*100}%`;const figure=root.querySelector('.current-photo'),img=figure?.querySelector('img'),photo=state.images[day.id];if(figure&&img&&photo){figure.hidden=false;figure.dataset.remote=/^https?:/.test(photo.url)?'true':'false';figure.dataset.src=photo.url;img.src=photo.url;img.alt=photo.description}};render();window.addEventListener('focus',render);setInterval(render,60000)}
</script>
<style>.current-banner{max-width:1320px;margin:2rem auto;padding:0 clamp(1rem,4vw,3rem);display:grid;grid-template-columns:minmax(300px,.9fr) 1.1fr;background:var(--deep);color:#fff}.current-banner-image{min-height:350px}.current-banner-image :global(.current-photo){height:100%}.current-content{padding:clamp(1.5rem,4vw,3rem)}.current-content .eyebrow,.current-number{color:var(--gold)}.current-content h2{font-size:clamp(2rem,4vw,4rem);margin:.3rem 0}.current-details{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1.2rem 0}.current-details ul{padding-left:1rem;margin:.4rem 0}.current-details p{margin:.4rem 0}.progress{height:5px;background:#ffffff33;margin:1.3rem 0}.progress span{display:block;height:100%;background:var(--gold);transition:width .3s}@media(max-width:700px){.current-banner{margin:1rem 0;padding:0;grid-template-columns:1fr}.current-banner-image{min-height:230px}.current-details{grid-template-columns:1fr}}</style>
