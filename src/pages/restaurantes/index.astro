---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { marrakechRestaurants, restaurantCategories } from '../../data/marrakech-restaurants';
---
<BaseLayout title="Guía gastronómica de Marrakech"><section class="page-intro"><p class="eyebrow">Sabores de Marrakech</p><h1>Dónde comer y tomar algo</h1><p>Selección práctica para cada zona del recorrido. Los precios son orientativos y las opciones sin reserva dependen de disponibilidad.</p></section><section class="section" data-filter-root><div class="filters"><label>Zona<select data-filter="zone"><option value="">Todas</option>{[...new Set(marrakechRestaurants.map(r=>r.zone))].map(zone=><option value={zone}>{zone}</option>)}</select></label><label>Jornada<select data-filter="day"><option value="">Todas</option><option value="19-diciembre">19 dic.</option><option value="20-diciembre">20 dic.</option><option value="21-diciembre">21 dic.</option><option value="22-diciembre">22 dic.</option></select></label><label>Categoría<select data-filter="category"><option value="">Todas</option>{Object.entries(restaurantCategories).map(([id,label])=><option value={id}>{label}</option>)}</select></label><label>Reserva<select data-filter="reserved"><option value="">Todas</option><option value="yes">Con reserva / prevista</option></select></label></div><div class="food-grid">{marrakechRestaurants.map(r=><article class="food-card catalog-card" data-zone={r.zone} data-day={r.recommendedDays.join(' ')} data-category={r.categories.join(' ')} data-reserved={r.reservationId ? 'yes' : 'no'}><p class="eyebrow">{r.role.replace('_',' ')}</p>{r.reservationStatus && <span class="badge">{r.reservationStatus.replace('_',' ')}</span>}<h2>{r.name}</h2><p>{r.description}</p><p><b>{r.specialties}</b> · {r.zone}</p><p class="price">{r.price}</p><div class="tags">{r.categories.map(category=><span>{restaurantCategories[category]}</span>)}</div><a class="text-link" href={`/restaurantes/${r.id}/`}>Abrir ficha</a><button class="favorite" data-favorite={r.id} aria-pressed="false">Guardar favorito ♡</button></article>)}</div></section><section class="section paper"><p class="eyebrow">Atardecer y vistas</p><h2>Terrazas panorámicas</h2><div class="food-grid">{marrakechRestaurants.filter(r=>r.terrace).map(r=><article class="food-card"><h3>{r.name}</h3><p>{r.reason}</p><p><b>{r.price}</b> · {r.views}</p><a href={`/restaurantes/${r.id}/`}>Ver ficha</a></article>)}</div></section></BaseLayout>
<style>.food-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.food-card{display:flex;flex-direction:column;gap:.5rem}.food-card .favorite{margin-top:auto}.price{color:var(--terra);font-weight:700}.tags{display:flex;flex-wrap:wrap;gap:.35rem}.tags span{font-size:.7rem;padding:.15rem .4rem;background:var(--beige)}@media(max-width:700px){.food-grid{grid-template-columns:1fr}}</style>
